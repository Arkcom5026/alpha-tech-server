{
  "name": "your-project",
  "version": "1.0.0",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npm run test:certification",
    "test:regression": "node tests/customer-receipt-auth-regression.test.js",
    "test:auth-receipt": "node tests/customer-receipt-auth-regression.test.js",
    "test:inventory": "node scripts/run-module-tests.js --list",
    "test:modules": "node scripts/run-module-tests.js",
    "test:tax-intake": "node tests/tax-intake-foundation.contract.test.js && node tests/tax-intake-http.contract.test.js && node tests/tax-lifecycle-sale-source.contract.test.js && node tests/tax-step-004-sales-publication.contract.test.js",
    "test:certification": "npm run test:regression && npm run test:modules && npm run test:tax-intake",
    "verify:product-runtime-controller": "node tests/operational-product-runtime-controller.contract.bootstrap.js",
    "verify:product-create-compatibility": "node tests/product-create-compatibility.contract.test.js",
    "verify:product-backend-migration": "npm run verify:product-runtime-controller && npm run verify:product-create-compatibility",
    "verify:employee-lifecycle": "node scripts/verify-employee-lifecycle-runtime.js",
    "purge:category": "node scripts/purge-category-hierarchy.js",
    "backup": "node recovery/jobRunner.js --mode backup-workflow"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@node-rs/bcrypt": "^1.10.7",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "prisma": "^6.16.2"
  }
}
