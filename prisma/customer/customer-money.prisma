model CustomerMoneyApplication {
  id          Int      @id @default(autoincrement())
  branchId    Int
  customerId  Int
  sourceType  String   @db.VarChar(50)
  sourceId    Int
  targetType  String   @db.VarChar(50)
  targetId    Int
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("APPLIED") @db.VarChar(30)
  appliedAt   DateTime @default(now())
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer        CustomerProfile               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  ledgerEntries   CustomerMoneyLedger[]
  settlementLines CustomerMoneySettlementLine[]

  @@index([customerId])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([branchId])
}

model CustomerMoneySettlement {
  id             Int       @id @default(autoincrement())
  code           String    @unique @db.VarChar(50)
  branchId       Int
  customerId     Int
  settlementType String    @default("DELIVERY_CREDIT") @db.VarChar(30)
  totalAmount    Decimal   @db.Decimal(12, 2)
  status         String    @default("ACTIVE") @db.VarChar(30)
  settledAt      DateTime  @default(now())
  note           String?
  createdById    Int
  cancelledAt    DateTime?
  cancelledById  Int?
  cancelReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer CustomerProfile                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines    CustomerMoneySettlementLine[]
  command  CustomerMoneySettlementCommand?

  @@index([branchId])
  @@index([customerId])
  @@index([branchId, status, settledAt])
}

model CustomerMoneySettlementCommand {
  id           Int      @id @default(autoincrement())
  branchId     Int
  customerId   Int
  commandKey   String   @db.VarChar(100)
  requestHash  String   @db.VarChar(64)
  settlementId Int      @unique
  createdAt    DateTime @default(now())

  settlement CustomerMoneySettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@unique([branchId, commandKey])
  @@index([customerId, createdAt])
}

model CustomerMoneySettlementLine {
  id            Int      @id @default(autoincrement())
  settlementId  Int
  applicationId Int
  saleId        Int
  saleCode      String   @db.VarChar(100)
  saleItemType  String   @db.VarChar(20)
  saleItemId    Int
  description   String
  quantity      Decimal  @db.Decimal(12, 2)
  unitAmount    Decimal  @db.Decimal(12, 2)
  lineAmount    Decimal  @db.Decimal(12, 2)
  appliedAmount Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  settlement  CustomerMoneySettlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  application CustomerMoneyApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@index([applicationId])
  @@index([saleId])
  @@index([saleItemType, saleItemId])
}

model CustomerMoneyLedger {
  id            Int      @id @default(autoincrement())
  branchId      Int
  customerId    Int
  applicationId Int?
  eventType     String   @db.VarChar(50)
  amount        Decimal  @db.Decimal(12, 2)
  direction     String   @db.VarChar(20)
  referenceType String?  @db.VarChar(50)
  referenceId   Int?
  createdById   Int
  createdAt     DateTime @default(now())

  customer    CustomerProfile           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  application CustomerMoneyApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([applicationId])
  @@index([referenceType, referenceId])
  @@index([branchId])
}

model CustomerMoneyBalance {
  id              Int      @id @default(autoincrement())
  branchId        Int
  customerId      Int
  availableAmount Decimal  @db.Decimal(12, 2)
  updatedAt       DateTime @updatedAt

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([branchId, customerId])
  @@index([customerId])
}