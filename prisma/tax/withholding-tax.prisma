enum WithholdingTaxFormType {
  PND3
  PND53
}

enum WithholdingTaxRecordStatus {
  DRAFT
  READY
  CERTIFIED
  FILED
  VOIDED
}

enum WithholdingTaxCertificateStatus {
  DRAFT
  ISSUED
  VOIDED
}

enum WithholdingTaxFilingStatus {
  DRAFT
  PREPARED
  SUBMITTED
  VOIDED
}

model WithholdingTaxTreatmentEvent {
  id                  String                 @id @default(cuid())
  branchId            Int
  taxExpenseId        Int
  taxExpenseItemId    Int
  previousTreatment   TaxExpenseWhtTreatment
  resultingTreatment  TaxExpenseWhtTreatment
  actorEmployeeId     Int
  note                String?
  occurredAt          DateTime               @default(now())
  createdAt           DateTime               @default(now())

  @@index([branchId, taxExpenseId, occurredAt])
  @@index([taxExpenseItemId, occurredAt])
  @@index([actorEmployeeId])
}

model WithholdingTaxCertificate {
  id                    String                       @id @default(cuid())
  branchId              Int
  taxExpenseId          Int                          @unique
  taxPeriodId           String?
  formType              WithholdingTaxFormType
  certificateNumber     String
  status                WithholdingTaxCertificateStatus @default(DRAFT)
  issuerSnapshot        Json
  payeeSnapshot         Json
  issuedAt              DateTime?
  version               Int                          @default(1)
  createdByEmployeeId   Int
  issuedByEmployeeId    Int?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@unique([id, branchId])
  @@unique([branchId, certificateNumber])
  @@index([branchId, taxPeriodId, formType, status])
}

model WithholdingTaxRecord {
  id                    String                     @id @default(cuid())
  branchId              Int
  taxExpenseId          Int
  taxExpenseItemId      Int                        @unique
  taxPeriodId           String?
  certificateId         String?
  formType              WithholdingTaxFormType
  payeeType             ExpensePayeeType
  payeeName             String
  payeeTaxId            String?
  payeeBranchCode       String?                    @db.VarChar(5)
  paidAt                DateTime
  incomeDescription     String
  taxableBaseAmount     Decimal                    @db.Decimal(14, 2)
  withholdingTaxRate    Decimal                    @db.Decimal(5, 2)
  withholdingTaxAmount  Decimal                    @db.Decimal(14, 2)
  status                WithholdingTaxRecordStatus @default(DRAFT)
  createdByEmployeeId   Int
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([id, branchId])
  @@index([branchId, taxExpenseId])
  @@index([branchId, certificateId])
  @@index([branchId, taxPeriodId, formType, status])
  @@index([branchId, paidAt])
  @@index([payeeTaxId])
}

model WithholdingTaxFilingBatch {
  id                    String                     @id @default(cuid())
  branchId              Int
  taxPeriodId           String
  formType              WithholdingTaxFormType
  year                  Int
  month                 Int
  status                WithholdingTaxFilingStatus @default(DRAFT)
  itemCount             Int                        @default(0)
  taxableBaseAmount     Decimal                    @default(0) @db.Decimal(14, 2)
  withholdingTaxAmount  Decimal                    @default(0) @db.Decimal(14, 2)
  preparedByEmployeeId  Int?
  preparedAt            DateTime?
  submittedByEmployeeId Int?
  submittedAt           DateTime?
  submissionEvidence    Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([branchId, taxPeriodId, formType])
  @@unique([id, branchId])
  @@index([branchId, year, month, formType, status])
}

model WithholdingTaxFilingItem {
  id                     String   @id @default(cuid())
  branchId               Int
  batchId                String
  withholdingTaxRecordId String   @unique
  taxExpenseId           Int
  certificateId          String
  certificateNumber      String
  payeeName              String
  payeeTaxId             String?
  paidAt                 DateTime
  taxableBaseAmount      Decimal  @db.Decimal(14, 2)
  withholdingTaxRate     Decimal  @db.Decimal(5, 2)
  withholdingTaxAmount   Decimal  @db.Decimal(14, 2)
  sourceSnapshot         Json
  createdAt              DateTime @default(now())

  @@unique([batchId, withholdingTaxRecordId])
  @@index([branchId, batchId])
  @@index([taxExpenseId])
  @@index([certificateId])
}
