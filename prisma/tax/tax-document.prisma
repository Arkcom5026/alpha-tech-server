enum TaxIssuerProfileStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

model TaxIssuerProfile {
  id                         Int                    @id @default(autoincrement())
  branchId                   Int                    @unique
  legalName                  String?
  taxId                      String?                @db.VarChar(13)
  registeredAddress          String?
  branchCode                 String                 @default("00000") @db.VarChar(5)
  isHeadOffice               Boolean                @default(false)
  shortTaxInvoicePrefix      String?
  fullTaxInvoicePrefix       String?
  nextShortTaxInvoiceNumber  Int                    @default(1)
  nextFullTaxInvoiceNumber   Int                    @default(1)
  creditNotePrefix           String?
  nextCreditNoteNumber       Int                    @default(1)
  status                     TaxIssuerProfileStatus @default(DRAFT)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  branch                     Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  issuedTaxDocuments         TaxDocument[]          @relation("TaxDocumentIssuerProfile")

  @@index([status])
}

model TaxCandidate {
  id                 Int                @id @default(autoincrement())
  branchId           Int
  sourceType         String
  sourceId           String
  sourceDocumentNo   String?
  registrationKey    String             @unique
  status             TaxCandidateStatus @default(REGISTERED)
  occurredAt         DateTime
  snapshot           Json               @default("{}")
  mappedDocumentType String?
  rejectionCode      String?
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now())
  branch             Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  document           TaxDocument?

  @@unique([branchId, sourceType, sourceId])
  @@index([branchId, status, occurredAt])
  @@index([sourceType, sourceId])
}

model TaxDocument {
  id                  Int                         @id @default(autoincrement())
  branchId            Int
  candidateId         Int?                        @unique
  documentType        String
  documentNumber      String
  counterpartyTaxId   String?
  identityKey         String                      @unique
  status              String                      @default("DRAFT")
  issuedAt            DateTime?
  occurredAt          DateTime
  currency            String                      @default("THB")
  subtotalAmount      Decimal                     @default(0) @db.Decimal(14, 2)
  taxAmount           Decimal                     @default(0) @db.Decimal(14, 2)
  totalAmount         Decimal                     @default(0) @db.Decimal(14, 2)
  snapshot            Json                        @default("{}")
  taxInvoiceKind      TaxInvoiceKind?
  issuerProfileId     Int?
  issuedDocumentNumber String?
  issuedSequence      Int?
  issuerSnapshot      Json?
  recipientSnapshot   Json?
  originalTaxDocumentId Int?                       @unique
  saleReturnId         Int?                         @unique
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @default(now())
  branch              Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  candidate           TaxCandidate?               @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  issuerProfile       TaxIssuerProfile?           @relation("TaxDocumentIssuerProfile", fields: [issuerProfileId], references: [id], onDelete: Restrict)
  lifecycleEvents     TaxDocumentLifecycleEvent[]
  inputTaxFilingItems InputTaxFilingItem[]
  salesTaxFilingItems SalesTaxFilingItem[]
  outputVatRecord     OutputVatRecord?
  adjustedOutputVatRecords OutputVatRecord[]       @relation("OutputVatOriginalTaxDocument")
  inputVatRecord      InputVatRecord?
  adjustedInputVatRecords InputVatRecord[]         @relation("InputVatOriginalTaxDocument")
  originalTaxDocument TaxDocument?                 @relation("TaxDocumentCreditNote", fields: [originalTaxDocumentId], references: [id], onDelete: Restrict)
  creditNote          TaxDocument?                 @relation("TaxDocumentCreditNote")
  saleReturn          SaleReturn?                  @relation("TaxDocumentCreditNoteSaleReturn", fields: [saleReturnId], references: [id], onDelete: Restrict)

  @@index([branchId, status, occurredAt])
  @@index([branchId, documentType, documentNumber])
  @@index([issuerProfileId], map: "TaxDocument_issuerProfileId_idx")
  @@unique([issuerProfileId, taxInvoiceKind, issuedSequence], map: "TaxDocument_issuer_kind_sequence_key")
  @@unique([issuerProfileId, taxInvoiceKind, issuedDocumentNumber], map: "TaxDocument_issuer_kind_number_key")
  @@unique([id, branchId], map: "TaxDocument_id_branchId_key")
}

model TaxPeriod {
  id               String          @id
  branchId         Int
  periodCode       String
  startDate        DateTime
  endDate          DateTime
  status           TaxPeriodStatus @default(OPEN)
  closedAt         DateTime?
  submittedAt      DateTime?
  reopenedAt       DateTime?
  lockedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now())
  branch           Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  outputVatRecords OutputVatRecord[]
  inputVatRecords  InputVatRecord[]
  vatCarryForwardAuthority VatCarryForwardAuthority? @relation("VatCarryForwardTarget")
  vatCarryForwardSources   VatCarryForwardAuthority[] @relation("VatCarryForwardSource")

  @@unique([branchId, periodCode])
  @@unique([id, branchId], map: "TaxPeriod_id_branchId_key")
  @@index([branchId, status])
  @@index([startDate, endDate])
}

model OutputVatRecord {
  id                     String          @id @default(cuid())
  branchId               Int
  taxDocumentId          Int             @unique
  taxPeriodId            String?
  ledgerType             TaxLedgerType
  replayKey              String          @unique
  authorityVersion       Int             @default(1)
  documentType           String
  taxInvoiceKind         TaxInvoiceKind?
  documentNumber         String
  issuedDocumentNumber   String?
  documentDate           DateTime
  currency               String          @default("THB")
  subtotalAmount         Decimal         @db.Decimal(14, 2)
  taxAmount              Decimal         @db.Decimal(14, 2)
  totalAmount            Decimal         @db.Decimal(14, 2)
  counterpartyName       String?
  counterpartyTaxId      String?
  counterpartyBranchCode String?         @db.VarChar(5)
  issuerSnapshot         Json
  recipientSnapshot      Json?
  documentSnapshot       Json
  originalTaxDocumentId  Int?
  originalDocumentNumber String?
  projectedAt            DateTime        @default(now())
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  branch                 Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  taxDocument            TaxDocument     @relation(fields: [taxDocumentId, branchId], references: [id, branchId], onDelete: Restrict)
  taxPeriod              TaxPeriod?      @relation(fields: [taxPeriodId, branchId], references: [id, branchId], onDelete: Restrict)
  originalTaxDocument    TaxDocument?     @relation("OutputVatOriginalTaxDocument", fields: [originalTaxDocumentId, branchId], references: [id, branchId], onDelete: Restrict)

  @@unique([taxDocumentId, branchId], map: "OutputVatRecord_taxDocumentId_branchId_key")
  @@index([branchId, documentDate])
  @@index([branchId, ledgerType, documentDate])
  @@index([taxPeriodId, documentDate])
  @@index([originalTaxDocumentId])
}

model InputVatRecord {
  id                     String          @id @default(cuid())
  branchId               Int
  taxDocumentId          Int             @unique
  taxPeriodId            String?
  ledgerType             TaxLedgerType
  replayKey              String          @unique
  authorityVersion       Int             @default(1)
  documentType           String
  documentNumber         String
  documentDate           DateTime
  currency               String          @default("THB")
  subtotalAmount         Decimal         @db.Decimal(14, 2)
  taxAmount              Decimal         @db.Decimal(14, 2)
  totalAmount            Decimal         @db.Decimal(14, 2)
  supplierName           String?
  supplierTaxId          String?
  supplierBranchCode     String?         @db.VarChar(5)
  documentSnapshot       Json
  originalTaxDocumentId  Int?
  originalDocumentNumber String?
  projectedAt            DateTime        @default(now())
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  branch                 Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  taxDocument            TaxDocument     @relation(fields: [taxDocumentId, branchId], references: [id, branchId], onDelete: Restrict)
  taxPeriod              TaxPeriod?      @relation(fields: [taxPeriodId, branchId], references: [id, branchId], onDelete: Restrict)
  originalTaxDocument    TaxDocument?     @relation("InputVatOriginalTaxDocument", fields: [originalTaxDocumentId, branchId], references: [id, branchId], onDelete: Restrict)

  @@unique([taxDocumentId, branchId], map: "InputVatRecord_taxDocumentId_branchId_key")
  @@index([branchId, documentDate])
  @@index([branchId, ledgerType, documentDate])
  @@index([taxPeriodId, documentDate])
  @@index([originalTaxDocumentId])
}

model TaxDocumentLifecycleEvent {
  id              Int              @id @default(autoincrement())
  taxDocumentId   Int
  fromStatus      String?
  toStatus        String
  reason          String?
  actorEmployeeId Int?
  occurredAt      DateTime         @default(now())
  metadata        Json?
  createdAt       DateTime         @default(now())
  taxDocument     TaxDocument      @relation(fields: [taxDocumentId], references: [id], onDelete: Restrict)
  actorEmployee   EmployeeProfile? @relation(fields: [actorEmployeeId], references: [id], onDelete: SetNull)

  @@index([taxDocumentId, occurredAt])
  @@index([actorEmployeeId, occurredAt])
}

enum TaxCandidateStatus {
  REGISTERED
  MAPPED
  REJECTED
  CONVERTED
}

enum TaxDocumentType {
  TAX_INVOICE
  ABBREVIATED_TAX_INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  REPLACEMENT
  VOID
}

enum TaxLifecycleStatus {
  DRAFT
  VALIDATED
  ISSUED
  REPORTED
  LOCKED
  CANCELLED
  REPLACED
  ARCHIVED
}

enum TaxSourceType {
  SALE
  SALE_RETURN
  PURCHASE_RECEIPT
  REPAIR
  WARRANTY_CLAIM
  MANUAL
}

enum TaxEventType {
  CREATED
  VALIDATED
  ISSUED
  REPORTED
  LOCKED
  CANCELLED
  REPLACED
  ARCHIVED
}

enum TaxLedgerType {
  OUTPUT_VAT
  INPUT_VAT
  OUTPUT_VAT_ADJUSTMENT
  INPUT_VAT_ADJUSTMENT
}

enum TaxPeriodStatus {
  OPEN
  CLOSED
  LOCKED
  SUBMITTED
  REOPENED
}
