enum TaxExpenseStatus {
  DRAFT
  RECORDED
  UNDER_REVIEW
  FINALIZED
  VOIDED
}

enum TaxExpenseCounterpartyType {
  SUPPLIER
  EXPENSE_PAYEE
  OTHER
}

enum ExpensePayeeType {
  INDIVIDUAL
  LEGAL_ENTITY
  GOVERNMENT
  OTHER
}

enum TaxExpenseVatTreatment {
  PENDING_REVIEW
  CREDITABLE
  NON_CREDITABLE
  OUT_OF_SCOPE
}

enum TaxExpenseCitTreatment {
  PENDING_REVIEW
  DEDUCTIBLE
  NON_DEDUCTIBLE
  PARTIALLY_DEDUCTIBLE
}

enum TaxExpenseWhtTreatment {
  NOT_APPLICABLE
  PENDING_REVIEW
  WITHHOLDING_REQUIRED
  WITHHELD
}

enum TaxExpenseEvidenceStatus {
  MISSING
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum TaxExpenseAssessmentStatus {
  DRAFT
  FINALIZED
  SUPERSEDED
}

enum TaxExpenseAttachmentType {
  TAX_INVOICE
  RECEIPT
  WITHHOLDING_CERTIFICATE
  SUPPORTING_DOCUMENT
  OTHER
}

enum TaxExpenseLifecycleEventType {
  CREATED
  RECORDED
  REVIEW_REQUESTED
  ASSESSMENT_FINALIZED
  VOIDED
}

model TaxExpenseCategory {
  id        Int      @id @default(autoincrement())
  branchId  Int
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items     TaxExpenseItem[] @relation("TaxExpenseItemCategory")

  @@unique([branchId, code])
  @@unique([id, branchId])
  @@index([branchId, active])
}

model ExpensePayee {
  id                  Int              @id @default(autoincrement())
  branchId            Int
  payeeType           ExpensePayeeType @default(LEGAL_ENTITY)
  name                String
  taxId               String?          @db.VarChar(13)
  taxBranchCode       String?          @default("00000") @db.VarChar(5)
  address             String?
  phone               String?
  email               String?
  contactPerson       String?
  notes               String?
  active              Boolean          @default(true)
  createdByEmployeeId Int
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  branch              Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdByEmployee   EmployeeProfile  @relation("ExpensePayeeCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  taxExpenses         TaxExpense[]     @relation("TaxExpenseExpensePayee")

  @@unique([id, branchId])
  @@index([branchId, active])
  @@index([branchId, name])
  @@index([branchId, taxId])
  @@index([createdByEmployeeId])
}

model TaxExpense {
  id                   Int                       @id @default(autoincrement())
  branchId             Int
  supplierId           Int?
  expensePayeeId       Int?
  expenseNumber        String
  counterpartyType     TaxExpenseCounterpartyType
  counterpartyName     String
  counterpartyTaxId    String?
  documentNumber       String?
  documentDate         DateTime?
  expenseDate          DateTime
  receivedAt           DateTime?
  status               TaxExpenseStatus          @default(DRAFT)
  evidenceStatus       TaxExpenseEvidenceStatus  @default(MISSING)
  currency             String                    @default("THB") @db.VarChar(3)
  subtotalAmount       Decimal                   @default(0) @db.Decimal(14, 2)
  vatAmount            Decimal                   @default(0) @db.Decimal(14, 2)
  totalAmount          Decimal                   @default(0) @db.Decimal(14, 2)
  withholdingTaxAmount Decimal                   @default(0) @db.Decimal(14, 2)
  paymentDueAmount     Decimal                   @default(0) @db.Decimal(14, 2)
  note                 String?
  createdByEmployeeId  Int
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  branch               Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier             Supplier?                 @relation("TaxExpenseSupplier", fields: [supplierId, branchId], references: [id, branchId], onDelete: Restrict)
  expensePayee         ExpensePayee?              @relation("TaxExpenseExpensePayee", fields: [expensePayeeId, branchId], references: [id, branchId], onDelete: Restrict)
  createdByEmployee    EmployeeProfile           @relation("TaxExpenseCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  items                TaxExpenseItem[]          @relation("TaxExpenseItemExpense")
  assessments          TaxExpenseAssessment[]
  lifecycleEvents      TaxExpenseLifecycleEvent[]
  attachments          TaxExpenseAttachment[]

  @@unique([branchId, expenseNumber])
  @@unique([id, branchId])
  @@index([branchId, status, expenseDate])
  @@index([branchId, supplierId])
  @@index([branchId, expensePayeeId])
  @@index([branchId, documentNumber])
  @@index([createdByEmployeeId])
}

model TaxExpenseItem {
  id                  Int                   @id @default(autoincrement())
  taxExpenseId        Int
  categoryId          Int
  branchId            Int
  lineNumber          Int
  description         String
  quantity            Decimal               @default(1) @db.Decimal(14, 2)
  unitAmount          Decimal               @db.Decimal(14, 2)
  subtotalAmount      Decimal               @db.Decimal(14, 2)
  vatTreatment        TaxExpenseVatTreatment @default(PENDING_REVIEW)
  vatAmount           Decimal               @default(0) @db.Decimal(14, 2)
  citTreatment        TaxExpenseCitTreatment @default(PENDING_REVIEW)
  whtTreatment        TaxExpenseWhtTreatment @default(NOT_APPLICABLE)
  withholdingTaxRate  Decimal?              @db.Decimal(5, 2)
  withholdingTaxAmount Decimal               @default(0) @db.Decimal(14, 2)
  createdAt           DateTime              @default(now())
  taxExpense          TaxExpense            @relation("TaxExpenseItemExpense", fields: [taxExpenseId, branchId], references: [id, branchId], onDelete: Restrict)
  category            TaxExpenseCategory    @relation("TaxExpenseItemCategory", fields: [categoryId, branchId], references: [id, branchId], onDelete: Restrict)

  @@unique([taxExpenseId, lineNumber])
  @@index([branchId])
  @@index([categoryId])
}

model TaxExpenseAssessment {
  id                  Int                       @id @default(autoincrement())
  taxExpenseId        Int
  version             Int
  status              TaxExpenseAssessmentStatus @default(DRAFT)
  vatTreatment        TaxExpenseVatTreatment
  citTreatment        TaxExpenseCitTreatment
  whtTreatment        TaxExpenseWhtTreatment
  assessmentNote      String?
  assessmentSnapshot  Json?
  assessmentHash      String
  assessedByEmployeeId Int?
  assessedAt          DateTime?
  createdAt           DateTime                  @default(now())
  taxExpense          TaxExpense                @relation(fields: [taxExpenseId], references: [id], onDelete: Restrict)
  assessedByEmployee  EmployeeProfile?          @relation("TaxExpenseAssessmentAssessedBy", fields: [assessedByEmployeeId], references: [id], onDelete: Restrict)

  @@unique([taxExpenseId, version])
  @@unique([taxExpenseId, assessmentHash])
  @@index([assessedByEmployeeId])
}

model TaxExpenseLifecycleEvent {
  id                  Int                         @id @default(autoincrement())
  taxExpenseId        Int
  eventType           TaxExpenseLifecycleEventType
  previousStatus      TaxExpenseStatus?
  resultingStatus     TaxExpenseStatus?
  actorEmployeeId     Int?
  reasonCode          String?
  note                String?
  metadata            Json?
  occurredAt          DateTime                    @default(now())
  createdAt           DateTime                    @default(now())
  taxExpense          TaxExpense                  @relation(fields: [taxExpenseId], references: [id], onDelete: Restrict)
  actorEmployee       EmployeeProfile?            @relation("TaxExpenseLifecycleEventActor", fields: [actorEmployeeId], references: [id], onDelete: Restrict)

  @@index([taxExpenseId, occurredAt])
  @@index([actorEmployeeId])
  @@index([eventType, occurredAt])
}

model TaxExpenseAttachment {
  id                  Int                     @id @default(autoincrement())
  taxExpenseId        Int
  attachmentType      TaxExpenseAttachmentType
  evidenceStatus      TaxExpenseEvidenceStatus @default(PENDING_REVIEW)
  storageKey          String
  originalFileName    String
  contentType         String
  byteSize            Int
  sha256              String
  uploadedByEmployeeId Int
  createdAt           DateTime                @default(now())
  taxExpense          TaxExpense              @relation(fields: [taxExpenseId], references: [id], onDelete: Restrict)
  uploadedByEmployee  EmployeeProfile         @relation("TaxExpenseAttachmentUploadedBy", fields: [uploadedByEmployeeId], references: [id], onDelete: Restrict)

  @@unique([taxExpenseId, sha256])
  @@index([uploadedByEmployeeId])
}
