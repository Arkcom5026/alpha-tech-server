enum MissingCostResolutionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED_FOR_CORRECTION
  CANCELLED
  SUPERSEDED
}

enum MissingCostEvidenceSourceType {
  LEGACY_INVOICE
  SUPPLIER_DOCUMENT
  PURCHASE_RECORD
  HISTORICAL_COST_REFERENCE
  MANUAL_BUSINESS_DECISION
}

enum MissingCostEvidenceConfidence {
  HIGH
  MEDIUM
  LOW
}

enum MissingCostResolutionEventType {
  CREATED
  EVIDENCE_VERSION_CREATED
  UPDATED
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED_FOR_CORRECTION
  CANCELLED
  SUPERSEDED
  RECOVERY_PREVIEW_REQUESTED
}

model MissingCostResolution {
  id                    Int                         @id @default(autoincrement())
  branchId              Int
  stockBalanceId        Int
  productId             Int
  sourceAuditId         String
  sourceSnapshotHash    String
  candidateId           String
  candidateIdentityHash String
  candidateEntryId      String
  status                MissingCostResolutionStatus @default(DRAFT)
  currentVersion        Int                         @default(1)
  createdByEmployeeId   Int
  approvedByEmployeeId  Int?
  approvedAt            DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  branch                Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stockBalance          StockBalance                @relation(fields: [stockBalanceId], references: [id], onDelete: Restrict)
  product               Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdByEmployee     EmployeeProfile             @relation("MissingCostResolutionCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  approvedByEmployee    EmployeeProfile?            @relation("MissingCostResolutionApprovedBy", fields: [approvedByEmployeeId], references: [id], onDelete: Restrict)
  versions              MissingCostResolutionVersion[]
  events                MissingCostResolutionEvent[]

  @@unique([branchId, candidateIdentityHash])
  @@unique([branchId, candidateId])
  @@index([branchId, status])
  @@index([branchId, productId])
  @@index([branchId, stockBalanceId])
  @@index([branchId, createdAt])
  @@index([sourceSnapshotHash])
}

model MissingCostResolutionVersion {
  id                    Int                             @id @default(autoincrement())
  resolutionId          Int
  version               Int
  sourceType            MissingCostEvidenceSourceType
  sourceReference       String
  evidenceSummary       String
  proposedUnitCost      Decimal                         @db.Decimal(12, 2)
  effectiveDate         DateTime
  confidence            MissingCostEvidenceConfidence
  rationale             String
  proposerEmployeeId    Int
  evidenceHash          String
  candidateSnapshotHash String
  submittedAt           DateTime?
  approvedAt            DateTime?
  approvedByEmployeeId  Int?
  approvalSnapshot      Json?
  createdAt             DateTime                        @default(now())
  resolution            MissingCostResolution           @relation(fields: [resolutionId], references: [id], onDelete: Restrict)
  proposerEmployee      EmployeeProfile                 @relation("MissingCostResolutionVersionProposer", fields: [proposerEmployeeId], references: [id], onDelete: Restrict)
  approvedByEmployee    EmployeeProfile?                @relation("MissingCostResolutionVersionApprover", fields: [approvedByEmployeeId], references: [id], onDelete: Restrict)
  events                MissingCostResolutionEvent[]

  @@unique([resolutionId, version])
  @@unique([resolutionId, evidenceHash])
  @@index([resolutionId, createdAt])
  @@index([proposerEmployeeId])
  @@index([approvedByEmployeeId])
  @@index([evidenceHash])
}

model MissingCostResolutionEvent {
  id                    Int                            @id @default(autoincrement())
  resolutionId          Int
  versionId             Int?
  eventType             MissingCostResolutionEventType
  previousStatus        MissingCostResolutionStatus?
  resultingStatus       MissingCostResolutionStatus?
  actorEmployeeId       Int
  reasonCode            String
  note                  String?
  evidenceHash          String?
  candidateSnapshotHash String?
  eventHash             String
  occurredAt            DateTime                       @default(now())
  createdAt             DateTime                       @default(now())
  resolution            MissingCostResolution          @relation(fields: [resolutionId], references: [id], onDelete: Restrict)
  version               MissingCostResolutionVersion?  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  actorEmployee         EmployeeProfile                @relation("MissingCostResolutionEventActor", fields: [actorEmployeeId], references: [id], onDelete: Restrict)

  @@unique([resolutionId, eventHash])
  @@index([resolutionId, occurredAt])
  @@index([versionId])
  @@index([actorEmployeeId])
  @@index([eventType, occurredAt])
}
