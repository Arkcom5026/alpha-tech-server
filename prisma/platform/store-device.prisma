enum StoreDeviceGatewayEnrollmentState {
  PENDING_ENROLLMENT
  ENROLLED
  REVOKED
}

enum StoreDeviceGatewayRuntimeState {
  OFFLINE
  ONLINE
  DEGRADED
}

enum StoreDeviceGatewaySessionState {
  CONNECTED
  AUTHENTICATED
  DISCONNECTED
  REVOKED
  EXPIRED
}

enum StoreDeviceJobType {
  PRINT_DOCUMENT
  PRINT_LABEL
  DEVICE_DIAGNOSTIC
}

enum StoreDeviceJobStatus {
  PENDING
  LEASED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StoreDeviceJobLeaseStatus {
  OFFERED
  ACKNOWLEDGED
  COMPLETED
  FAILED
  EXPIRED
  REVOKED
}

enum StoreDeviceJobResultStatus {
  SUCCEEDED
  FAILED
  CANCELLED
}

model StoreDeviceGateway {
  id                   Int                                @id @default(autoincrement())
  branchId             Int
  gatewayId            String
  enrollmentState      StoreDeviceGatewayEnrollmentState @default(PENDING_ENROLLMENT)
  runtimeState         StoreDeviceGatewayRuntimeState    @default(OFFLINE)
  credentialVersion    Int
  capabilitiesSnapshot Json?
  platformSnapshot     Json?
  lastHeartbeatAt      DateTime?
  lastAuthenticatedAt  DateTime?
  revokedAt            DateTime?
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt

  branch     Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sessions   StoreDeviceGatewaySession[] @relation("StoreDeviceGatewaySessions")
  jobLeases  StoreDeviceJobLease[]       @relation("StoreDeviceGatewayLeases")
  jobResults StoreDeviceJobResult[]      @relation("StoreDeviceGatewayResults")

  @@unique([id, branchId])
  @@unique([branchId, gatewayId])
  @@index([branchId, enrollmentState])
  @@index([branchId, runtimeState])
}

model StoreDeviceGatewaySession {
  id                Int                            @id @default(autoincrement())
  branchId          Int
  gatewayId         Int
  sessionId         String
  credentialVersion Int
  challengeId       String?
  state             StoreDeviceGatewaySessionState @default(CONNECTED)
  reconnectCursor   String?
  connectedAt       DateTime                       @default(now())
  authenticatedAt   DateTime?
  disconnectedAt    DateTime?
  revokedAt         DateTime?
  expiresAt         DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  branch     Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  gateway    StoreDeviceGateway        @relation("StoreDeviceGatewaySessions", fields: [branchId, gatewayId], references: [branchId, id], onDelete: Restrict)
  jobLeases  StoreDeviceJobLease[]     @relation("StoreDeviceGatewaySessionLeases")
  jobResults StoreDeviceJobResult[]    @relation("StoreDeviceGatewaySessionResults")

  @@unique([id, branchId])
  @@unique([branchId, sessionId])
  @@unique([id, branchId, gatewayId])
  @@index([branchId, gatewayId, state])
  @@index([branchId, expiresAt])
}

model StoreDeviceJob {
  id              Int                  @id @default(autoincrement())
  branchId        Int
  jobId           String
  idempotencyKey  String
  jobType         StoreDeviceJobType
  source          String
  status          StoreDeviceJobStatus @default(PENDING)
  targetDeviceId  String?
  targetProfileId String?
  requestSnapshot Json
  correlationId   String?
  causationId     String?
  requestedAt     DateTime             @default(now())
  completedAt     DateTime?
  failedAt        DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  branch  Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  leases  StoreDeviceJobLease[]
  results StoreDeviceJobResult[]

  @@unique([id, branchId])
  @@unique([branchId, jobId])
  @@unique([branchId, idempotencyKey])
  @@index([branchId, status, requestedAt])
  @@index([branchId, correlationId])
}

model StoreDeviceJobLease {
  id             Int                       @id @default(autoincrement())
  branchId       Int
  jobId          Int
  gatewayId      Int
  sessionId      Int
  leaseId        String
  status         StoreDeviceJobLeaseStatus @default(OFFERED)
  attemptNumber  Int
  expiresAt      DateTime
  acknowledgedAt DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  branch  Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  job     StoreDeviceJob            @relation(fields: [branchId, jobId], references: [branchId, id], onDelete: Restrict)
  gateway StoreDeviceGateway        @relation("StoreDeviceGatewayLeases", fields: [branchId, gatewayId], references: [branchId, id], onDelete: Restrict)
  session StoreDeviceGatewaySession @relation("StoreDeviceGatewaySessionLeases", fields: [branchId, gatewayId, sessionId], references: [branchId, gatewayId, id], onDelete: Restrict)
  result  StoreDeviceJobResult?

  @@unique([id, branchId])
  @@unique([branchId, leaseId])
  @@unique([jobId, attemptNumber])
  @@index([branchId, gatewayId, status])
  @@index([branchId, sessionId, status])
  @@index([branchId, expiresAt])
}

model StoreDeviceJobResult {
  id                Int                        @id @default(autoincrement())
  branchId          Int
  jobId             Int
  leaseId           Int                        @unique
  gatewayId         Int
  sessionId         Int
  resultId          String
  status            StoreDeviceJobResultStatus
  adapterEvidence   Json?
  transportEvidence Json?
  resultSnapshot    Json
  errorMetadata     Json?
  executedAt        DateTime
  recordedAt        DateTime                   @default(now())

  branch  Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  job     StoreDeviceJob            @relation(fields: [branchId, jobId], references: [branchId, id], onDelete: Restrict)
  lease   StoreDeviceJobLease       @relation(fields: [branchId, leaseId], references: [branchId, id], onDelete: Restrict)
  gateway StoreDeviceGateway        @relation("StoreDeviceGatewayResults", fields: [branchId, gatewayId], references: [branchId, id], onDelete: Restrict)
  session StoreDeviceGatewaySession @relation("StoreDeviceGatewaySessionResults", fields: [branchId, gatewayId, sessionId], references: [branchId, gatewayId, id], onDelete: Restrict)

  @@unique([branchId, resultId])
  @@unique([branchId, leaseId])
  @@index([branchId, jobId, recordedAt])
  @@index([branchId, gatewayId, recordedAt])
}
