// Partner Store Application Foundation
// A public application is intentionally not a Branch and grants no operating access.

enum PartnerStoreApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PartnerStoreProvisioningStatus {
  NOT_STARTED
  IN_PROGRESS
  PROVISIONED
  FAILED
}

enum PartnerStoreActivationStatus {
  NOT_STARTED
  INVITED
  ACTIVE
}

enum PartnerStoreApplicationEventType {
  SUBMITTED
  REVIEW_STARTED
  APPROVED
  REJECTED
  WITHDRAWN
  PROVISIONING_STARTED
  STORE_PROVISIONED
  PROVISIONING_FAILED
  ACTIVATION_INVITATION_ISSUED
  OWNER_ACTIVATED
}

model PartnerStoreApplication {
  id                       Int                            @id @default(autoincrement())
  applicationCode          String                         @unique
  businessName             String
  contactName              String
  contactPhone             String
  contactEmail             String?
  businessAddress          String?
  requestedStorefrontSlug  String?
  note                     String?
  status                   PartnerStoreApplicationStatus @default(PENDING)
  provisioningStatus       PartnerStoreProvisioningStatus @default(NOT_STARTED)
  activationStatus         PartnerStoreActivationStatus  @default(NOT_STARTED)
  reviewNote               String?
  provisionedBranchId      Int?                           @unique
  provisionedOwnerUserId   Int?                           @unique
  decidedAt                DateTime?
  provisioningAttemptedAt  DateTime?
  provisionedAt            DateTime?
  provisioningFailureCode  String?
  activatedAt              DateTime?
  provisionedBranch        Branch?                        @relation("PartnerStoreApplicationProvisionedBranch", fields: [provisionedBranchId], references: [id], onDelete: Restrict)
  provisionedOwnerUser     User?                          @relation("PartnerStoreApplicationProvisionedOwner", fields: [provisionedOwnerUserId], references: [id], onDelete: Restrict)
  events                   PartnerStoreApplicationEvent[]
  activationInvitations    PartnerStoreActivationInvitation[]
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt

  @@index([status, createdAt])
  @@index([provisioningStatus, createdAt])
  @@index([activationStatus, createdAt])
  @@index([contactPhone, createdAt])
  @@index([requestedStorefrontSlug])
}

model PartnerStoreApplicationEvent {
  id                           Int                              @id @default(autoincrement())
  applicationId                Int
  eventType                    PartnerStoreApplicationEventType
  previousStatus               PartnerStoreApplicationStatus?
  resultingStatus              PartnerStoreApplicationStatus
  previousProvisioningStatus   PartnerStoreProvisioningStatus?
  resultingProvisioningStatus  PartnerStoreProvisioningStatus?
  previousActivationStatus     PartnerStoreActivationStatus?
  resultingActivationStatus    PartnerStoreActivationStatus?
  actorUserId                  Int?
  note                         String?
  metadata                     Json?
  createdAt                    DateTime                         @default(now())
  application                  PartnerStoreApplication          @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([eventType, createdAt])
  @@index([actorUserId])
}

model PartnerStoreActivationInvitation {
  id              Int                     @id @default(autoincrement())
  applicationId   Int
  tokenHash       String                  @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  consumedAt      DateTime?
  createdByUserId Int
  createdAt       DateTime                @default(now())
  application     PartnerStoreApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([consumedAt])
}
