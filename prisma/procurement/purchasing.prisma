enum SupplierCapability {
  PROCUREMENT
  EXPENSE_PAYEE
}

enum PurchaseOrderStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  PAID
  COMPLETED
  CANCELLED
}

enum ReceiptStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ReceiptSource {
  PO
  QUICK
}

model Supplier {
  id                   Int                    @id @default(autoincrement())
  name                 String
  address              String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  contactPerson        String?
  country              String?                @default("Thailand")
  creditLimit          Decimal?               @default(0) @db.Decimal(12, 2)
  email                String?
  notes                String?
  paymentTerms         Int?                   @default(0)
  phone                String?
  postalCode           String?
  province             String?
  taxId                String?
  accountNumber        String?
  accountType          String?
  bankId               Int?
  branchId             Int
  active               Boolean                @default(true)
  creditBalance        Decimal?               @default(0) @db.Decimal(12, 2)
  taxBranchCode        String?                @default("00000")
  isSystem             Boolean                @default(false)
  pos                  PurchaseOrder[]
  PurchaseOrderReceipt PurchaseOrderReceipt[]
  bank                 Bank?                  @relation(fields: [bankId], references: [id])
  branch               Branch                 @relation(fields: [branchId], references: [id])
  supplierPayment      SupplierPayment[]
  supplierPayables     SupplierPayable[]
  supplierPayableDisputes SupplierPayableDispute[]
  supplierPayableAdjustments SupplierPayableAdjustment[]
  supplierAdvances     SupplierAdvance[]
  warrantyClaims       WarrantyClaim[]
  taxExpenses          TaxExpense[] @relation("TaxExpenseSupplier")
  capabilities         SupplierCapabilityAssignment[]

  @@unique([branchId, name])
  @@unique([id, branchId])
}

model SupplierCapabilityAssignment {
  id         Int                @id @default(autoincrement())
  supplierId Int
  capability SupplierCapability
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  supplier   Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([supplierId, capability])
  @@index([capability, supplierId])
}

model Bank {
  id        Int        @id @default(autoincrement())
  name      String
  branchId  Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  active    Boolean    @default(true)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier  Supplier[]

  @@unique([branchId, name])
  @@index([branchId])
  @@index([branchId, active])
}

model PurchaseOrder {
  id         Int                    @id @default(autoincrement())
  code       String                 @unique
  date       DateTime               @default(now())
  note       String?
  status     PurchaseOrderStatus    @default(PENDING)
  supplierId Int
  branchId   Int
  employeeId Int
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  branch     Branch                 @relation(fields: [branchId], references: [id])
  employee   EmployeeProfile        @relation(fields: [employeeId], references: [id])
  supplier   Supplier               @relation(fields: [supplierId], references: [id])
  items      PurchaseOrderItem[]
  receipts   PurchaseOrderReceipt[]
}

model PurchaseOrderItem {
  id               Int                        @id @default(autoincrement())
  productId        Int
  quantity         Int
  purchaseOrderId  Int
  receivedQuantity Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  costPrice        Decimal                    @db.Decimal(12, 2)
  product          Product                    @relation(fields: [productId], references: [id])
  purchaseOrder    PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receipts         PurchaseOrderReceiptItem[]
}

model PurchaseOrderReceipt {
  id                       Int                        @id @default(autoincrement())
  receivedAt               DateTime                   @default(now())
  note                     String?
  purchaseOrderId          Int?
  branchId                 Int
  receivedById             Int
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  code                     String                     @unique
  printed                  Boolean                    @default(false)
  paidAmount               Decimal?                   @db.Decimal(12, 2)
  totalAmount              Decimal?                   @db.Decimal(12, 2)
  statusPayment            PaymentStatus              @default(UNPAID)
  statusReceipt            ReceiptStatus              @default(PENDING)
  supplierTaxInvoiceDate   DateTime?
  supplierTaxInvoiceNumber String?
  deliveryNoteNumber       String?
  deliveryNoteDate         DateTime?
  taxDocumentMode          InputTaxDocumentMode       @default(UNCLASSIFIED)
  taxDocumentReceivedAt    DateTime?
  taxDocumentReceiptSource TaxDocumentReceiptSource?
  vatRate                  Decimal?                   @default(7) @db.Decimal(5, 2)
  source                   ReceiptSource              @default(PO)
  supplierId               Int?
  barcodeReceiptItem       BarcodeReceiptItem[]
  inputTaxFilingItems      InputTaxFilingItem[]
  branch                   Branch                     @relation(fields: [branchId], references: [id])
  purchaseOrder            PurchaseOrder?             @relation(fields: [purchaseOrderId], references: [id])
  receivedBy               EmployeeProfile            @relation(fields: [receivedById], references: [id])
  supplier                 Supplier?                  @relation(fields: [supplierId], references: [id])
  items                    PurchaseOrderReceiptItem[]
  supplierPaymentReceipts  SupplierPaymentReceipt[]
  supplierPayableReceiptLinks SupplierPayableReceiptLink[]

  @@index([branchId, receivedAt])
  @@index([branchId, taxDocumentMode, receivedAt])
  @@index([purchaseOrderId])
  @@index([source, receivedAt])
}

model PurchaseOrderReceiptItem {
  id                  Int                  @id @default(autoincrement())
  receiptId           Int
  purchaseOrderItemId Int?
  quantity            Decimal              @db.Decimal(12, 2)
  costPrice           Decimal              @db.Decimal(12, 2)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  productId           Int?
  barcodeReceiptItem  BarcodeReceiptItem[]
  product             Product?             @relation(fields: [productId], references: [id])
  purchaseOrderItem   PurchaseOrderItem?   @relation(fields: [purchaseOrderItemId], references: [id])
  receipt             PurchaseOrderReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  simpleLots          SimpleLot[]
  stockItems          StockItem[]

  @@index([receiptId])
  @@index([productId])
}
