// ProductReservation aggregate mapping for existing database tables.
// This file documents the recovered Prisma authority for Slice 1.
// It is not loaded by Prisma CLI until consolidated into schema.prisma.

enum ProductReservationActorType {
  EMPLOYEE
  COMMERCE_IDENTITY
}

enum ProductReservationLifecycleStatus {
  ACTIVE
  ACCEPTED
  FULFILLMENT_READY
  CANCELLED
  EXPIRED
}

model ProductReservation {
  id                    Int                               @id @default(autoincrement())
  code                  String                            @unique
  branchId              Int
  customerId            Int?
  createdByEmployeeId   Int?
  actorType             ProductReservationActorType       @default(EMPLOYEE)
  commerceIdentityId    Int?
  anonymousSessionId    Int?
  idempotencyKey        String?
  status                ProductReservationLifecycleStatus @default(ACTIVE)
  orderSource           OnlineOrderSource
  sourceReference       String?
  fulfillmentMethod     OnlineFulfillmentMethod
  totalBeforeDiscount   Decimal                           @db.Decimal(12, 2)
  totalDiscount         Decimal                           @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal                           @db.Decimal(12, 2)
  depositAmount         Decimal                           @default(0) @db.Decimal(12, 2)
  expiresAt             DateTime?
  acceptedAt            DateTime?
  fulfillmentReadyAt    DateTime?
  cancelledAt           DateTime?
  expiredAt             DateTime?
  stockReleasedAt       DateTime?
  terminalCommandKey    String?
  version               Int                               @default(1)
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  items                 ProductReservationItem[]

  @@index([branchId, status, createdAt])
  @@index([status, expiresAt])
  @@unique([branchId, terminalCommandKey])
}

model ProductReservationItem {
  id             Int                @id @default(autoincrement())
  reservationId  Int
  lineId         String
  lineType       String
  productId      Int
  stockItemId    Int?
  simpleLotId    Int?
  quantity       Decimal            @db.Decimal(12, 2)
  basePrice      Decimal            @db.Decimal(12, 2)
  discount       Decimal            @default(0) @db.Decimal(12, 2)
  price          Decimal            @db.Decimal(12, 2)
  vatAmount      Decimal            @default(0) @db.Decimal(12, 2)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  reservation    ProductReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([reservationId, lineId])
  @@index([reservationId, isActive])
  @@index([productId])
}
