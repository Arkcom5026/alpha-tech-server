model RepairSubcontract {
  id                     Int      @id @default(autoincrement())
  branchId               Int
  repairJobId            Int
  expensePayeeId         Int
  status                 String   @default("SENT") @db.VarChar(32)
  providerName           String
  providerPhone          String?
  workScope              String
  externalReference      String?
  trackingNumber         String?
  customerEstimateAmount Decimal? @db.Decimal(12, 2)
  customerApprovalNote   String?
  providerQuotedAmount   Decimal? @db.Decimal(12, 2)
  providerQuoteNote      String?
  customerDecisionNote   String?
  actualExternalCost     Decimal? @db.Decimal(12, 2)
  transportCost          Decimal? @db.Decimal(12, 2)
  materialCost           Decimal? @db.Decimal(12, 2)
  otherOperationalCost   Decimal? @db.Decimal(12, 2)
  resultNote             String?
  sentAt                 DateTime @default(now())
  expectedReturnAt       DateTime?
  returnRequestedAt      DateTime?
  returnedAt             DateTime?
  sentByEmployeeId       Int
  returnedByEmployeeId   Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  repairJob              RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Restrict)
  expensePayee           ExpensePayee @relation(fields: [expensePayeeId, branchId], references: [id, branchId], onDelete: Restrict)
  taxExpenses            TaxExpense[] @relation("TaxExpenseRepairSubcontract")

  @@index([branchId, status, sentAt])
  @@index([repairJobId, sentAt])
  @@index([repairJobId, status])
  @@index([branchId, expensePayeeId])
  @@index([sentByEmployeeId])
  @@index([returnedByEmployeeId])
}
