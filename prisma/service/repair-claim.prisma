enum DeviceCategory {
  DESKTOP_COMPUTER
  NOTEBOOK
  PRINTER
  MONITOR
  UPS
  NETWORK_DEVICE
  MOBILE_DEVICE
  TABLET
  STORAGE_DEVICE
  ACCESSORY
  OTHER
}

enum DeviceSourceType {
  SALE
  SALE_RETURN
  STOCK_ITEM
  PURCHASE_RECEIPT
  DEVICE_OWNERSHIP
  DEVICE_INTAKE
  REPAIR_JOB
  REPAIR_DIAGNOSIS
  REPAIR_PART
  REPAIR_LABOR
  REPAIR_QUALITY_CHECK
  REPAIR_DELIVERY
  WARRANTY_CLAIM
  WARRANTY_CLAIM_EVENT
  MANUAL
  IMPORT
  SYSTEM
  OTHER
}

enum RepairEstimateApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
  EXPIRED
}

enum DeviceStatus {
  ACTIVE
  IN_REPAIR
  IN_WARRANTY_CLAIM
  RETIRED
  LOST
}

enum DeviceOwnershipType {
  OWNER
  CUSTODIAN
  BORROWER
}

enum DeviceActorType {
  EMPLOYEE
  CUSTOMER
  SYSTEM
}

enum DevicePassportEventType {
  REGISTERED
  OWNERSHIP_CHANGED
  PURCHASED
  SOLD
  RETURNED
  INTAKE_CREATED
  INTAKE_RECEIVED
  INTAKE_INSPECTION_COMPLETED
  INTAKE_CANCELLED
  REPAIR_CREATED
  REPAIR_ASSIGNED
  REPAIR_STATUS_CHANGED
  DIAGNOSIS_STARTED
  DIAGNOSIS_COMPLETED
  DIAGNOSIS_REVISED
  PART_ADDED
  PART_REMOVED
  LABOR_ADDED
  LABOR_COMPLETED
  QC_STARTED
  QC_PASSED
  QC_FAILED
  DELIVERY_PREPARED
  DELIVERED
  WARRANTY_CLAIM_OPENED
  WARRANTY_CLAIM_SUBMITTED
  WARRANTY_CLAIM_PROVIDER_RECEIVED
  WARRANTY_CLAIM_RESOLVED
  WARRANTY_CLAIM_CANCELLED
  WARRANTY_REPLACED
  WARRANTY_CREDITED
  DEVICE_STATUS_CHANGED
  NOTE_ADDED
  /// Compatibility event values retained during runtime migration.
  INTAKE
  REPAIR_UPDATED
  WARRANTY_CLAIM_UPDATED
  STATUS_CHANGED
}

enum WarrantyClaimRepairLinkState {
  UNLINKED_LEGACY
  LINKED_VERIFIED
  MANUAL_REVIEW_REQUIRED
}

enum WarrantyClaimStatus {
  DRAFT
  SUBMITTED
  IN_TRANSIT
  RECEIVED_BY_PROVIDER
  INSPECTING
  APPROVED
  REJECTED
  REPAIRING
  REPLACEMENT_PENDING
  CREDIT_PENDING
  RESOLVED
  CANCELLED
}

enum WarrantyClaimResolution {
  REPAIRED
  REPLACED
  CREDITED
  REFUNDED
  RETURNED_UNCHANGED
  REJECTED
  WRITTEN_OFF
}

enum RepairDiagnosisStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REVISED
  CANCELLED
}

enum RepairQcStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  WAIVED
}

enum RepairDeliveryStatus {
  PENDING
  READY
  DELIVERED
  CANCELLED
}

enum RepairDeliveryMethod {
  PICKUP_AT_BRANCH
  COURIER
  DELIVERY_BY_STORE
  OTHER
}

model RepairJob {
  id               Int              @id @default(autoincrement())
  jobNo            String           @unique
  branchId         Int
  customerId       Int
  stockItemId      Int?
  deviceId         Int?
  deviceModel      String
  reportedSymptoms String
  technicianNotes  String?
  status           ServiceStatus    @default(RECEIVED)
  estimatedCost    Decimal          @default(0.0) @db.Decimal(12, 2)
  depositPaid      Decimal          @default(0.0) @db.Decimal(12, 2)
  technicianId     Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  branch           Branch           @relation(fields: [branchId], references: [id])
  customer         CustomerProfile  @relation(fields: [customerId], references: [id])
  stockItem        StockItem?       @relation(fields: [stockItemId], references: [id])
  device           Device?          @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  technician       EmployeeProfile? @relation(fields: [technicianId], references: [id])
  partsUsed        RepairPartItem[]

  warrantyClaims WarrantyClaim[]
  deviceIntake   DeviceIntake?
  diagnosis      RepairDiagnosis?
  laborItems     RepairLaborItem[]
  qualityCheck   RepairQualityCheck?
  delivery       RepairDelivery?
  trackingAccesses RepairTrackingAccess[]
  estimateApprovals RepairEstimateApproval[]
  subcontracts RepairSubcontract[]
  communicationPreference RepairCommunicationPreference?
  communicationActivities RepairCommunicationActivity[]
  taxExpenses TaxExpense[] @relation("TaxExpenseRepairJob")

  @@index([branchId])
  @@index([stockItemId])
  @@index([deviceId])
}

model RepairTrackingAccess {
  id                    Int              @id @default(autoincrement())
  repairJobId           Int
  tokenHash             String           @unique @db.VarChar(64)
  expiresAt             DateTime?
  revokedAt             DateTime?
  lastAccessedAt        DateTime?
  createdByEmployeeId   Int?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  repairJob             RepairJob        @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  createdBy             EmployeeProfile? @relation("RepairTrackingAccessCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  @@index([repairJobId, createdAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model RepairEstimateApproval {
  id                    Int                          @id @default(autoincrement())
  repairJobId           Int
  estimateAmount        Decimal                      @db.Decimal(12, 2)
  depositAmount         Decimal                      @default(0.0) @db.Decimal(12, 2)
  balanceAmount         Decimal                      @db.Decimal(12, 2)
  status                RepairEstimateApprovalStatus @default(PENDING)
  requestNote           String?
  customerNote          String?
  confirmedByName       String?
  requestedByEmployeeId Int?
  requestedAt           DateTime                     @default(now())
  expiresAt             DateTime?
  decidedAt             DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  repairJob   RepairJob        @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  requestedBy EmployeeProfile? @relation("RepairEstimateApprovalRequestedBy", fields: [requestedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([repairJobId, requestedAt])
  @@index([repairJobId, status])
  @@index([status, expiresAt])
}

model RepairPartItem {
  id          Int       @id @default(autoincrement())
  repairJobId Int
  productId   Int
  qtyUsed     Int       @default(1)
  unitPrice   Decimal   @db.Decimal(12, 2)
  product     Product   @relation(fields: [productId], references: [id])
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
}

model WarrantyClaim {
  id                     Int                             @id @default(autoincrement())
  branchId               Int
  stockItemId            Int?
  supplierId             Int?
  saleReturnItemId       Int?
  previousClaimId        Int?
  repairJobId            Int?
  deviceId               Int?
  repairLinkState        WarrantyClaimRepairLinkState    @default(UNLINKED_LEGACY)
  claimNo                String
  status                 WarrantyClaimStatus             @default(DRAFT)
  reason                 String
  serviceProvider        String?
  externalClaimRef       String?
  trackingNumber         String?
  resolution             WarrantyClaimResolution?
  resolutionNote         String?
  replacementStockItemId Int?
  creditAmount           Decimal?                        @db.Decimal(12, 2)
  openedAt               DateTime                        @default(now())
  submittedAt            DateTime?
  providerReceivedAt     DateTime?
  resolvedAt             DateTime?
  cancelledAt            DateTime?
  createdByEmployeeId    Int?
  resolvedByEmployeeId   Int?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  branch                 Branch                          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stockItem              StockItem?                      @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  supplier               Supplier?                       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  saleReturnItem         SaleReturnItem?                 @relation(fields: [saleReturnItemId], references: [id], onDelete: Restrict)
  repairJob              RepairJob?                      @relation(fields: [repairJobId], references: [id], onDelete: Restrict)
  device                 Device?                         @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  previousClaim          WarrantyClaim?                  @relation("WarrantyClaimHistory", fields: [previousClaimId], references: [id], onDelete: Restrict)
  subsequentClaims       WarrantyClaim[]                 @relation("WarrantyClaimHistory")
  replacementStockItem   StockItem?                      @relation("WarrantyClaimReplacementStockItem", fields: [replacementStockItemId], references: [id], onDelete: Restrict)
  createdBy              EmployeeProfile?                @relation("WarrantyClaimCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  resolvedBy             EmployeeProfile?                @relation("WarrantyClaimResolvedBy", fields: [resolvedByEmployeeId], references: [id], onDelete: Restrict)
  events                 WarrantyClaimEvent[]
  completionCommand      WarrantyClaimCompletionCommand?

  @@unique([branchId, claimNo])
  @@index([stockItemId, openedAt])
  @@index([supplierId, openedAt])
  @@index([saleReturnItemId])
  @@index([repairJobId, openedAt])
  @@index([deviceId])
  @@index([repairLinkState, openedAt])
  @@index([previousClaimId])
  @@index([replacementStockItemId])
  @@index([createdByEmployeeId])
  @@index([resolvedByEmployeeId])
  @@index([branchId, status, openedAt])
}

// ============================================================
// REPAIR EXECUTION AGGREGATE FOUNDATION
// Phase 3 ├óΓé¼ΓÇ¥ additive diagnosis, labor, quality control, delivery
// ============================================================

model RepairDiagnosis {
  id                    Int                   @id @default(autoincrement())
  repairJobId           Int                   @unique
  status                RepairDiagnosisStatus @default(PENDING)
  diagnosedByEmployeeId Int?
  symptomSummary        String?
  problemFound          String?
  rootCause             String?
  recommendedAction     String?
  diagnosticData        Json?
  estimatedLaborCost    Decimal               @default(0.0) @db.Decimal(12, 2)
  estimatedPartsCost    Decimal               @default(0.0) @db.Decimal(12, 2)
  diagnosedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  repairJob   RepairJob        @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  diagnosedBy EmployeeProfile? @relation("RepairDiagnosisDiagnosedBy", fields: [diagnosedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([status, diagnosedAt])
  @@index([diagnosedByEmployeeId, diagnosedAt])
}

model RepairLaborItem {
  id                    Int       @id @default(autoincrement())
  repairJobId           Int
  description           String
  quantity              Decimal   @default(1.0) @db.Decimal(10, 2)
  unitPrice             Decimal   @default(0.0) @db.Decimal(12, 2)
  performedByEmployeeId Int?
  startedAt             DateTime?
  completedAt           DateTime?
  note                  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  repairJob   RepairJob        @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  performedBy EmployeeProfile? @relation("RepairLaborPerformedBy", fields: [performedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([repairJobId, createdAt])
  @@index([performedByEmployeeId, completedAt])
}

model RepairQualityCheck {
  id                  Int            @id @default(autoincrement())
  repairJobId         Int            @unique
  status              RepairQcStatus @default(PENDING)
  checkedByEmployeeId Int?
  checklist           Json?
  note                String?
  checkedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  repairJob RepairJob        @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  checkedBy EmployeeProfile? @relation("RepairQualityCheckedBy", fields: [checkedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([status, checkedAt])
  @@index([checkedByEmployeeId, checkedAt])
}

model RepairDelivery {
  id                    Int                  @id @default(autoincrement())
  repairJobId           Int                  @unique
  status                RepairDeliveryStatus @default(PENDING)
  method                RepairDeliveryMethod @default(PICKUP_AT_BRANCH)
  deliveredByEmployeeId Int?
  recipientName         String?
  recipientPhone        String?
  customerConfirmedBy   String?
  customerConfirmedAt   DateTime?
  customerNote          String?
  paymentConfirmed      Boolean               @default(false)
  deviceReturned        Boolean               @default(false)
  accessoriesReturned   Boolean               @default(false)
  handoverSnapshot      Json?
  proofUrl              String?
  note                  String?
  deliveredAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  repairJob   RepairJob        @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  deliveredBy EmployeeProfile? @relation("RepairDeliveryDeliveredBy", fields: [deliveredByEmployeeId], references: [id], onDelete: SetNull)

  @@index([status, deliveredAt])
  @@index([deliveredByEmployeeId, deliveredAt])
}

/// Aggregate root representing the durable identity of a physical customer device.
/// Sale, repair, warranty, and future operational modules reference this identity
/// instead of creating competing device histories of their own.

// ============================================================
// DEVICE INTAKE AGGREGATE FOUNDATION
// Phase 2 ├óΓé¼ΓÇ¥ additive reception, evidence, consent, and audit data
// ============================================================

model Device {
  id                     Int                      @id @default(autoincrement())
  branchId               Int
  /// Read-optimized projection of the currently active OWNER history entry.
  /// Ownership mutations must update this field and DeviceOwnershipHistory atomically.
  currentOwnerCustomerId Int?
  stockItemId            Int?
  /// Runtime-generated immutable identity key. It is not a customer-facing serial,
  /// barcode, IMEI, or a concatenated business key.
  fingerprint            String                   @unique
  category               DeviceCategory?
  brand                  String?
  model                  String?
  serialNumber           String?
  imei                   String?
  barcode                String?
  status                 DeviceStatus             @default(ACTIVE)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  branch                 Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  currentOwner           CustomerProfile?         @relation("DeviceCurrentOwner", fields: [currentOwnerCustomerId], references: [id], onDelete: SetNull)
  stockItem              StockItem?               @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  repairJobs             RepairJob[]
  warrantyClaims         WarrantyClaim[]
  ownershipHistory       DeviceOwnershipHistory[]
  passportEvents         DevicePassportEvent[]

  deviceIntakes DeviceIntake[]

  @@unique([branchId, barcode])
  @@index([branchId])
  @@index([currentOwnerCustomerId])
  @@index([stockItemId])
  @@index([category])
  @@index([status])
}

/// Append-oriented ownership ledger and authority for device ownership history.
/// An active ownership entry has endedAt = null. Application policy must prevent
/// overlapping active OWNER periods for the same device.

model DeviceOwnershipHistory {
  id                  Int                 @id @default(autoincrement())
  deviceId            Int
  customerId          Int
  ownershipType       DeviceOwnershipType
  sourceType          DeviceSourceType?
  sourceId            String?
  createdByEmployeeId Int?
  startedAt           DateTime
  endedAt             DateTime?
  createdAt           DateTime            @default(now())
  device              Device              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  customer            CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy           EmployeeProfile?    @relation("DeviceOwnershipCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  @@index([deviceId, startedAt])
  @@index([deviceId, endedAt])
  @@index([customerId, startedAt])
  @@index([sourceType, sourceId])
}

// ============================================================
// DEVICE PASSPORT TIMELINE FOUNDATION
// Phase 4 ├óΓé¼ΓÇ¥ additive event vocabulary, idempotency and traceability
// ============================================================

/// Append-oriented operational ledger for the complete device passport timeline.
/// Domain modules publish events here; they must not overwrite historical events.

model DevicePassportEvent {
  id              Int                     @id @default(autoincrement())
  deviceId        Int
  branchId        Int
  eventType       DevicePassportEventType
  sourceType      DeviceSourceType?
  sourceId        String?
  /// Optional publisher-supplied idempotency key. A publisher must reuse the
  /// same key when retrying the same domain event for the same device.
  eventKey        String?
  /// Groups events produced by one operational request or workflow.
  correlationId   String?
  /// Identifies the preceding command/event when causal traceability is known.
  causationId     String?
  schemaVersion   Int                     @default(1)
  title           String
  description     String?
  actorType       DeviceActorType
  actorEmployeeId Int?
  actorCustomerId Int?
  customerVisible Boolean                 @default(false)
  metadata        Json?
  occurredAt      DateTime
  createdAt       DateTime                @default(now())
  device          Device                  @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  branch          Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actorEmployee   EmployeeProfile?        @relation("DevicePassportActor", fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  actorCustomer   CustomerProfile?        @relation("DevicePassportCustomerActor", fields: [actorCustomerId], references: [id], onDelete: SetNull)

  @@unique([deviceId, eventKey])
  @@index([deviceId, occurredAt])
  @@index([deviceId, eventType, occurredAt])
  @@index([branchId, eventType, occurredAt])
  @@index([sourceType, sourceId])
  @@index([correlationId, occurredAt])
  @@index([actorEmployeeId])
  @@index([actorCustomerId])
}

model WarrantyClaimEvent {
  id                    Int                 @id @default(autoincrement())
  warrantyClaimId       Int
  status                WarrantyClaimStatus
  note                  String?
  occurredAt            DateTime            @default(now())
  performedByEmployeeId Int?
  metadata              Json?
  createdAt             DateTime            @default(now())
  warrantyClaim         WarrantyClaim       @relation(fields: [warrantyClaimId], references: [id], onDelete: Restrict)
  performedBy           EmployeeProfile?    @relation(fields: [performedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([warrantyClaimId, occurredAt])
  @@index([performedByEmployeeId, occurredAt])
}

model WarrantyClaimCompletionCommand {
  id              Int           @id @default(autoincrement())
  branchId        Int
  commandKey      String
  requestHash     String
  warrantyClaimId Int           @unique
  createdAt       DateTime      @default(now())
  completedAt     DateTime      @default(now())
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warrantyClaim   WarrantyClaim @relation(fields: [warrantyClaimId], references: [id], onDelete: Restrict)

  @@unique([branchId, commandKey])
  @@index([branchId, createdAt])
}
