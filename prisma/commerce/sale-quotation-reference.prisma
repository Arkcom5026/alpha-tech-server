model SaleQuotationReference {
  id                Int      @id @default(autoincrement())
  branchId          Int
  saleId            Int      @unique
  quotationId       Int
  quotationCode     String
  quotationRevision Int      @default(0)
  quotationIssuedAt DateTime?
  linkedById        Int
  createdAt         DateTime @default(now())

  @@index([branchId, saleId])
  @@index([branchId, quotationId])
  @@index([branchId, quotationCode, quotationRevision])
}
