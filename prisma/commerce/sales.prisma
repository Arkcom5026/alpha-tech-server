enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
  WAITING_APPROVAL
}

enum PaymentSlipStatus {
  NONE
  WAITING_APPROVAL
  APPROVED
  REJECTED
}

enum RefundMethod {
  CASH
  TRANSFER
  CARD
  STORE_CREDIT
  OTHER
}

enum SaleType {
  NORMAL
  GOVERNMENT
  WHOLESALE
}

enum SaleStatus {
  DRAFT
  DELIVERED
  FINALIZED
  COMPLETED
  CANCELLED
}

enum PosHeldCartStatus {
  OPEN
  CONVERTED
  CANCELLED
}

enum PosHeldCartLineType {
  STOCK_ITEM
  SIMPLE
}

enum ReturnType {
  REFUND
  CLAIM
  EXCHANGE
  CREDIT_NOTE
  INTERNAL_USE
  STOCK_ERROR
}

enum PaymentType {
  ADVANCE
  RECEIPT_BASED
  CREDIT_NOTE
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  QR
  E_WALLET
  CHEQUE
  OTHER
  DEPOSIT
}

enum SaleReturnStatus {
  PENDING
  APPROVED
  STOCK_RESTORED
  COMPLETED
  REJECTED
  REFUNDED
}

enum CustomerReceiptStatus {
  ACTIVE
  FULLY_ALLOCATED
  CANCELLED
}

enum CombinedBillingStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Sale {
  id                         Int                         @id @default(autoincrement())
  code                       String                      @unique
  soldAt                     DateTime                    @default(now())
  customerId                 Int?
  employeeId                 Int
  branchId                   Int
  totalBeforeDiscount        Decimal                     @db.Decimal(12, 2)
  totalDiscount              Decimal                     @db.Decimal(12, 2)
  vat                        Decimal                     @db.Decimal(12, 2)
  vatRate                    Decimal                     @default(7) @db.Decimal(5, 2)
  totalAmount                Decimal                     @db.Decimal(12, 2)
  note                       String?
  refCode                    String?
  isTaxInvoice               Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  combinedDocumentId         Int?
  dueDate                    DateTime?
  finalizedAt                DateTime?
  isCredit                   Boolean                     @default(false)
  officialDocumentNumber     String?
  saleType                   SaleType                    @default(NORMAL)
  status                     SaleStatus                  @default(DRAFT)
  paid                       Boolean                     @default(false)
  paidAt                     DateTime?
  combinedBillingId          Int?
  sourceHeldCartId           Int?                        @unique
  paidAmount                 Decimal                     @default(0) @db.Decimal(12, 2)
  statusPayment              PaymentStatus               @default(UNPAID)
  customerReceiptAllocations CustomerReceiptAllocation[]
  depositUsages              DepositUsage[]
  payments                   Payment[]
  branch                     Branch                      @relation(fields: [branchId], references: [id])
  combinedBilling            CombinedBillingDocument?    @relation("CombinedBillingSales", fields: [combinedBillingId], references: [id])
  combinedDocument           CombinedSaleDocument?       @relation("SalesCombined", fields: [combinedDocumentId], references: [id])
  customer                   CustomerProfile?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  employee                   EmployeeProfile             @relation(fields: [employeeId], references: [id])
  items                      SaleItem[]
  simpleItems                SaleItemSimple[]
  returns                    SaleReturn[]
  salesTaxFilingItems        SalesTaxFilingItem[]
  completionCommand          SalesCompletionCommand?
  sourceHeldCart             PosHeldCart?                @relation("SaleSourceHeldCart", fields: [sourceHeldCartId], references: [id], onDelete: Restrict)

  @@index([combinedBillingId])
  @@index([branchId, soldAt])
  @@index([branchId, statusPayment, soldAt])
  @@index([branchId, statusPayment, dueDate])
  @@index([isCredit, dueDate])
  @@index([combinedDocumentId])
}

model SalesCompletionCommand {
  id          Int      @id @default(autoincrement())
  branchId    Int
  commandKey  String
  requestHash String
  saleId      Int      @unique
  createdAt   DateTime @default(now())
  completedAt DateTime @default(now())
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([branchId, commandKey])
  @@index([branchId, createdAt])
}

model PosHeldCart {
  id                  Int               @id @default(autoincrement())
  code                String            @unique
  branchId            Int
  customerId          Int?
  customerName        String?
  customerPhone       String?
  note                String?
  priceType           String            @default("retail")
  status              PosHeldCartStatus @default(OPEN)
  totalBeforeDiscount Decimal           @default(0) @db.Decimal(12, 2)
  totalDiscount       Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal           @default(0) @db.Decimal(12, 2)
  createdById         Int
  updatedById         Int
  cancelledById       Int?
  cancelledAt         DateTime?
  cancelReason        String?
  convertedAt         DateTime?
  lastActivityAt      DateTime          @default(now())
  version             Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  branch              Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer            CustomerProfile?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy           EmployeeProfile   @relation("PosHeldCartCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           EmployeeProfile   @relation("PosHeldCartUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  cancelledBy         EmployeeProfile?  @relation("PosHeldCartCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  convertedSale       Sale?             @relation("SaleSourceHeldCart")
  lines               PosHeldCartLine[]

  @@index([branchId, status, lastActivityAt])
  @@index([branchId, customerPhone, status])
  @@index([branchId, customerId, status])
}

model PosHeldCartLine {
  id           Int                 @id @default(autoincrement())
  heldCartId   Int
  lineKey      String
  lineType     PosHeldCartLineType
  productId    Int
  stockItemId  Int?
  simpleLotId  Int?
  barcode      String?
  productName  String
  modelName    String?
  quantity     Decimal             @db.Decimal(12, 2)
  unitPrice    Decimal             @db.Decimal(12, 2)
  discount     Decimal             @default(0) @db.Decimal(12, 2)
  remark       String?
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  heldCart     PosHeldCart         @relation(fields: [heldCartId], references: [id], onDelete: Cascade)
  product      Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockItem    StockItem?          @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  simpleLot    SimpleLot?          @relation(fields: [simpleLotId], references: [id], onDelete: Restrict)

  @@unique([heldCartId, lineKey])
  @@index([productId])
  @@index([stockItemId])
  @@index([simpleLotId])
}

model SaleItem {
  id                  Int              @id @default(autoincrement())
  saleId              Int
  stockItemId         Int
  basePrice           Decimal          @db.Decimal(12, 2)
  vatAmount           Decimal          @db.Decimal(12, 2)
  price               Decimal          @db.Decimal(12, 2)
  discount            Decimal          @db.Decimal(12, 2)
  refundedAmount      Decimal          @default(0) @db.Decimal(12, 2)
  returnedQuantity    Decimal          @default(0) @db.Decimal(12, 2)
  lastReturnedAt      DateTime?
  remark              String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  documentDescription String?
  documentPrefix      String?
  documentSuffix      String?
  sale                Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  stockItem           StockItem        @relation(fields: [stockItemId], references: [id])
  returnItems         SaleReturnItem[]

  @@index([stockItemId])
}

model SaleItemSimple {
  id                   Int                    @id @default(autoincrement())
  saleId               Int
  productId            Int
  quantity             Decimal                @db.Decimal(12, 2)
  basePrice            Decimal                @db.Decimal(12, 2)
  discount             Decimal                @db.Decimal(12, 2)
  price                Decimal                @db.Decimal(12, 2)
  vatAmount            Decimal                @db.Decimal(12, 2)
  remark               String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  simpleLotId          Int?
  unitCost             Decimal?               @db.Decimal(12, 2)
  documentDescription  String?
  documentPrefix       String?
  documentSuffix       String?
  returnedQuantity     Decimal                @default(0) @db.Decimal(12, 2)
  refundedAmount       Decimal                @default(0) @db.Decimal(12, 2)
  lastReturnedAt       DateTime?
  product              Product                @relation(fields: [productId], references: [id])
  sale                 Sale                   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  simpleLots           SimpleLot?             @relation(fields: [simpleLotId], references: [id])
  SaleReturnItemSimple SaleReturnItemSimple[]

  @@index([saleId])
  @@index([productId])
  @@index([simpleLotId])
}

model Payment {
  saleId               Int
  receivedAt           DateTime         @default(now())
  note                 String?
  combinedDocumentCode String?
  employeeProfileId    Int?
  branchId             Int
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  code                 String           @unique
  cancelNote           String?
  cancelledAt          DateTime?
  isCancelled          Boolean          @default(false)
  id                   Int              @id @default(autoincrement())
  depositUsages        DepositUsage[]
  branch               Branch           @relation(fields: [branchId], references: [id])
  employeeProfile      EmployeeProfile? @relation(fields: [employeeProfileId], references: [id])
  sale                 Sale             @relation(fields: [saleId], references: [id])
  items                PaymentItem[]

  @@index([saleId])
  @@index([branchId, receivedAt])
}

model PaymentItem {
  id                 Int                 @id @default(autoincrement())
  paymentId          Int
  amount             Decimal             @db.Decimal(12, 2)
  note               String?
  slipImage          String?
  cardRef            String?
  govImage           String?
  createdAt          DateTime            @default(now())
  paymentMethod      PaymentMethod
  payment            Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  refundTransactions RefundTransaction[]
}

model CombinedSaleDocument {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  issueDate      DateTime        @default(now())
  note           String?
  createdBy      Int
  branchId       Int
  totalAmount    Decimal         @db.Decimal(12, 2)
  finalAmount    Decimal         @db.Decimal(12, 2)
  adjustmentNote String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branch         Branch          @relation(fields: [branchId], references: [id])
  createdByUser  EmployeeProfile @relation(fields: [createdBy], references: [id])
  sales          Sale[]          @relation("SalesCombined")
}

model SaleReturn {
  id                    Int                          @id @default(autoincrement())
  code                  String                       @unique
  saleId                Int
  returnedAt            DateTime                     @default(now())
  employeeId            Int
  refundedByEmployeeId  Int?
  branchId              Int
  totalRefund           Decimal                      @db.Decimal(12, 2)
  note                  String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  returnType            ReturnType                   @default(REFUND)
  reason                String?
  deductedAmount        Decimal                      @default(0) @db.Decimal(12, 2)
  isFullyRefunded       Boolean                      @default(false)
  refundedAmount        Decimal                      @default(0) @db.Decimal(12, 2)
  refundMethod          RefundMethod
  status                SaleReturnStatus             @default(PENDING)
  approvedAt            DateTime?
  rejectedAt            DateTime?
  stockRestoredAt       DateTime?
  completedAt           DateTime?
  refundTransaction     RefundTransaction[]
  branch                Branch                       @relation(fields: [branchId], references: [id])
  employee              EmployeeProfile              @relation(fields: [employeeId], references: [id])
  refundedBy            EmployeeProfile?             @relation("RefundedBy", fields: [refundedByEmployeeId], references: [id])
  sale                  Sale                         @relation(fields: [saleId], references: [id])
  items                 SaleReturnItem[]
  saleReturnItemSimples SaleReturnItemSimple[]
  completionCommand     SaleReturnCompletionCommand?
  creditNoteTaxDocument TaxDocument?               @relation("TaxDocumentCreditNoteSaleReturn")

  @@index([saleId, returnedAt])
  @@index([branchId, returnedAt])
  @@index([branchId, status, returnedAt])
}

model SaleReturnItem {
  id             Int             @id @default(autoincrement())
  saleReturnId   Int
  saleItemId     Int
  refundAmount   Decimal         @db.Decimal(12, 2)
  reason         String?
  reasonCode     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  saleItem       SaleItem        @relation(fields: [saleItemId], references: [id])
  saleReturn     SaleReturn      @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  warrantyClaims WarrantyClaim[]

  @@unique([saleReturnId, saleItemId])
  @@index([saleReturnId])
  @@index([saleItemId])
}

model RefundTransaction {
  id                   Int             @id @default(autoincrement())
  saleReturnId         Int
  amount               Decimal         @db.Decimal(12, 2)
  note                 String?
  refundedAt           DateTime        @default(now())
  refundedByEmployeeId Int
  branchId             Int
  deducted             Decimal         @default(0) @db.Decimal(12, 2)
  method               RefundMethod
  sourcePaymentItemId  Int?
  referenceNo          String?
  branch               Branch          @relation(fields: [branchId], references: [id])
  refundedBy           EmployeeProfile @relation(fields: [refundedByEmployeeId], references: [id])
  saleReturn           SaleReturn      @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  sourcePaymentItem    PaymentItem?    @relation(fields: [sourcePaymentItemId], references: [id], onDelete: Restrict)

  @@index([saleReturnId])
  @@index([sourcePaymentItemId])
  @@index([branchId, refundedAt])
}

model SaleReturnCompletionCommand {
  id           Int        @id @default(autoincrement())
  branchId     Int
  commandKey   String
  requestHash  String
  saleReturnId Int        @unique
  createdAt    DateTime   @default(now())
  completedAt  DateTime   @default(now())
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Restrict)

  @@unique([branchId, commandKey])
  @@index([branchId, createdAt])
}

model CombinedBillingDocument {
  id             Int                   @id @default(autoincrement())
  code           String                @unique
  issueDate      DateTime              @default(now())
  note           String?
  createdBy      Int
  customerId     Int
  branchId       Int
  totalBeforeVat Decimal?              @db.Decimal(12, 2)
  vatAmount      Decimal?              @db.Decimal(12, 2)
  totalAmount    Decimal?              @db.Decimal(12, 2)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  status         CombinedBillingStatus @default(DRAFT)
  branch         Branch                @relation(fields: [branchId], references: [id])
  employee       EmployeeProfile       @relation(fields: [createdBy], references: [id])
  customer       CustomerProfile       @relation(fields: [customerId], references: [id])
  sales          Sale[]                @relation("CombinedBillingSales")
}

model PaymentCodeCounter {
  id       Int    @id @default(autoincrement())
  branchId Int
  yyyymmdd String
  lastNo   Int    @default(0)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, yyyymmdd])
}

model SaleReturnItemSimple {
  id               Int            @id @default(autoincrement())
  saleReturnId     Int
  saleItemSimpleId Int
  refundAmount     Decimal        @db.Decimal(12, 2)
  quantity         Decimal?       @db.Decimal(12, 2)
  reason           String?
  reasonCode       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  saleItemSimple   SaleItemSimple @relation(fields: [saleItemSimpleId], references: [id])
  saleReturn       SaleReturn     @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@unique([saleReturnId, saleItemSimpleId])
  @@index([saleReturnId])
  @@index([saleItemSimpleId])
}

model CustomerReceipt {
  id                           Int                         @id @default(autoincrement())
  code                         String                      @unique
  branchId                     Int
  customerId                   Int
  receivedAt                   DateTime                    @default(now())
  totalAmount                  Decimal                     @db.Decimal(12, 2)
  allocatedAmount              Decimal                     @default(0) @db.Decimal(12, 2)
  remainingAmount              Decimal                     @db.Decimal(12, 2)
  paymentMethod                PaymentMethod
  referenceNo                  String?
  note                         String?
  status                       CustomerReceiptStatus       @default(ACTIVE)
  createdByEmployeeProfileId   Int?
  cancelledByEmployeeProfileId Int?
  cancelledAt                  DateTime?
  cancelReason                 String?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  allocations                  CustomerReceiptAllocation[]
  branch                       Branch                      @relation(fields: [branchId], references: [id])
  cancelledByEmployeeProfile   EmployeeProfile?            @relation("CustomerReceiptCancelledBy", fields: [cancelledByEmployeeProfileId], references: [id])
  createdByEmployeeProfile     EmployeeProfile?            @relation("CustomerReceiptCreatedBy", fields: [createdByEmployeeProfileId], references: [id])
  customer                     CustomerProfile             @relation(fields: [customerId], references: [id])

  @@index([branchId, receivedAt])
  @@index([customerId, receivedAt])
  @@index([status])
  @@map("CustomerReceipts")
}

model CustomerReceiptAllocation {
  id                         Int              @id @default(autoincrement())
  receiptId                  Int
  saleId                     Int
  amount                     Decimal          @db.Decimal(12, 2)
  note                       String?
  allocatedAt                DateTime         @default(now())
  createdByEmployeeProfileId Int?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  createdByEmployeeProfile   EmployeeProfile? @relation("CustomerReceiptAllocationCreatedBy", fields: [createdByEmployeeProfileId], references: [id])
  receipt                    CustomerReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  sale                       Sale             @relation(fields: [saleId], references: [id])

  @@index([receiptId, allocatedAt])
  @@index([saleId, allocatedAt])
  @@index([createdByEmployeeProfileId])
  @@map("CustomerReceiptAllocations")
}
