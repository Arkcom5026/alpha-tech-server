enum TaxInvoiceKind {
  SHORT
  FULL
}

model TaxDocument {
  id                  Int                         @id @default(autoincrement())
  branchId            Int
  candidateId         Int?                        @unique
  documentType        String
  documentNumber      String
  counterpartyTaxId   String?
  identityKey         String                      @unique
  status              String                      @default("DRAFT")
  issuedAt            DateTime?
  occurredAt          DateTime
  currency            String                      @default("THB")
  subtotalAmount      Decimal                     @default(0) @db.Decimal(14, 2)
  taxAmount           Decimal                     @default(0) @db.Decimal(14, 2)
  totalAmount         Decimal                     @default(0) @db.Decimal(14, 2)
  snapshot            Json                        @default("{}")
  taxInvoiceKind      TaxInvoiceKind?
  issuerProfileId     Int?
  issuedDocumentNumber String?
  issuedSequence      Int?
  issuerSnapshot      Json?
  recipientSnapshot   Json?
  originalTaxDocumentId Int?                       @unique
  saleReturnId         Int?                         @unique
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @default(now())
  branch              Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  candidate           TaxCandidate?               @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  issuerProfile       TaxIssuerProfile?           @relation("TaxDocumentIssuerProfile", fields: [issuerProfileId], references: [id], onDelete: Restrict)
  lifecycleEvents     TaxDocumentLifecycleEvent[]
  inputTaxFilingItems InputTaxFilingItem[]
  originalTaxDocument TaxDocument?                 @relation("TaxDocumentCreditNote", fields: [originalTaxDocumentId], references: [id], onDelete: Restrict)
  creditNote          TaxDocument?                 @relation("TaxDocumentCreditNote")
  saleReturn          SaleReturn?                  @relation("TaxDocumentCreditNoteSaleReturn", fields: [saleReturnId], references: [id], onDelete: Restrict)

  @@index([branchId, status, occurredAt])
  @@index([branchId, documentType, documentNumber])
  @@index([issuerProfileId], map: "TaxDocument_issuerProfileId_idx")
  @@unique([issuerProfileId, taxInvoiceKind, issuedSequence], map: "TaxDocument_issuer_kind_sequence_key")
  @@unique([issuerProfileId, taxInvoiceKind, issuedDocumentNumber], map: "TaxDocument_issuer_kind_number_key")
}

