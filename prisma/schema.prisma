  sourceHeldCart             PosHeldCart?                @relation("SaleSourceHeldCart", fields: [sourceHeldCartId], references: [id], onDelete: Restrict)

  @@index([combinedBillingId])
  @@index([branchId, soldAt])
  @@index([branchId, statusPayment, soldAt])
  @@index([branchId, statusPayment, dueDate])
  @@index([isCredit, dueDate])
  @@index([combinedDocumentId])
}

