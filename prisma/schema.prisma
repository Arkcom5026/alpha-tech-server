model Device {
  id                     Int                      @id @default(autoincrement())
  branchId               Int
  /// Read-optimized projection of the currently active OWNER history entry.
  /// Ownership mutations must update this field and DeviceOwnershipHistory atomically.
  currentOwnerCustomerId Int?
  stockItemId            Int?
  /// Runtime-generated immutable identity key. It is not a customer-facing serial,
  /// barcode, IMEI, or a concatenated business key.
  fingerprint            String                   @unique
  category               DeviceCategory?
  brand                  String?
  model                  String?
  serialNumber           String?
  imei                   String?
  barcode                String?
  status                 DeviceStatus             @default(ACTIVE)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  branch                 Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  currentOwner           CustomerProfile?         @relation("DeviceCurrentOwner", fields: [currentOwnerCustomerId], references: [id], onDelete: SetNull)
  stockItem              StockItem?               @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  repairJobs             RepairJob[]
  warrantyClaims         WarrantyClaim[]
  ownershipHistory       DeviceOwnershipHistory[]
  passportEvents         DevicePassportEvent[]

  deviceIntakes DeviceIntake[]

  @@unique([branchId, barcode])
  @@index([branchId])
  @@index([currentOwnerCustomerId])
  @@index([stockItemId])
  @@index([category])
  @@index([status])
}

/// Append-oriented ownership ledger and authority for device ownership history.
/// An active ownership entry has endedAt = null. Application policy must prevent
/// overlapping active OWNER periods for the same device.
model DeviceOwnershipHistory {
  id                  Int                 @id @default(autoincrement())
  deviceId            Int
  customerId          Int
  ownershipType       DeviceOwnershipType
  sourceType          DeviceSourceType?
  sourceId            String?
  createdByEmployeeId Int?
  startedAt           DateTime
  endedAt             DateTime?
  createdAt           DateTime            @default(now())
  device              Device              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  customer            CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy           EmployeeProfile?    @relation("DeviceOwnershipCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  @@index([deviceId, startedAt])
  @@index([deviceId, endedAt])
  @@index([customerId, startedAt])
  @@index([sourceType, sourceId])
}

// ============================================================
// DEVICE PASSPORT TIMELINE FOUNDATION
// Phase 4 â€” additive event vocabulary, idempotency and traceability
// ============================================================

/// Append-oriented operational ledger for the complete device passport timeline.
/// Domain modules publish events here; they must not overwrite historical events.
model DevicePassportEvent {
  id              Int                     @id @default(autoincrement())
  deviceId        Int
  branchId        Int
  eventType       DevicePassportEventType
  sourceType      DeviceSourceType?
  sourceId        String?
  /// Optional publisher-supplied idempotency key. A publisher must reuse the
  /// same key when retrying the same domain event for the same device.
  eventKey        String?
  /// Groups events produced by one operational request or workflow.
  correlationId   String?
  /// Identifies the preceding command/event when causal traceability is known.
  causationId     String?
  schemaVersion   Int                     @default(1)
  title           String
  description     String?
  actorType       DeviceActorType
  actorEmployeeId Int?
  actorCustomerId Int?
  customerVisible Boolean                 @default(false)
  metadata        Json?
  occurredAt      DateTime
  createdAt       DateTime                @default(now())
  device          Device                  @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  branch          Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actorEmployee   EmployeeProfile?        @relation("DevicePassportActor", fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  actorCustomer   CustomerProfile?        @relation("DevicePassportCustomerActor", fields: [actorCustomerId], references: [id], onDelete: SetNull)

  @@unique([deviceId, eventKey])
  @@index([deviceId, occurredAt])
  @@index([deviceId, eventType, occurredAt])
  @@index([branchId, eventType, occurredAt])
  @@index([sourceType, sourceId])
  @@index([correlationId, occurredAt])
  @@index([actorEmployeeId])
  @@index([actorCustomerId])
}

