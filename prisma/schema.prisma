model MissingCostResolution {
  id                    Int                         @id @default(autoincrement())
  branchId              Int
  stockBalanceId        Int
  productId             Int
  sourceAuditId         String
  sourceSnapshotHash    String
  candidateId           String
  candidateIdentityHash String
  candidateEntryId      String
  status                MissingCostResolutionStatus @default(DRAFT)
  currentVersion        Int                         @default(1)
  createdByEmployeeId   Int
  approvedByEmployeeId  Int?
  approvedAt            DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  branch                Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stockBalance          StockBalance                @relation(fields: [stockBalanceId], references: [id], onDelete: Restrict)
  product               Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdByEmployee     EmployeeProfile             @relation("MissingCostResolutionCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  approvedByEmployee    EmployeeProfile?            @relation("MissingCostResolutionApprovedBy", fields: [approvedByEmployeeId], references: [id], onDelete: Restrict)
