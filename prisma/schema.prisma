generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String?              @unique
  password            String
  role                Role
  enabled             Boolean              @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  loginId             String?              @unique
  loginType           LoginType            @default(PHONE)
  cart                Cart[]
  customerProfile     CustomerProfile?
  employeeProfile     EmployeeProfile?
  orderOnline         OrderOnline[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  provisionedPartnerStoreApplications PartnerStoreApplication[] @relation("PartnerStoreApplicationProvisionedOwner")
}

model EmployeeProfile {
  id                                Int                         @id @default(autoincrement())
  name                              String?
  phone                             String?
  userId                            Int                         @unique
  branchId                          Int?
  positionId                        Int?
  createdAt                         DateTime                    @default(now())
  updatedAt                         DateTime                    @updatedAt
  approved                          Boolean                     @default(false)
  active                            Boolean                     @default(true)
  passwordHashV2                    String?
  v2Role                            EmployeeRole                @default(CASHIER)
  combinedBillingDocument           CombinedBillingDocument[]
  combinedSaleDocument              CombinedSaleDocument[]
  customerDeposit                   CustomerDeposit[]
  createdCustomerReceiptAllocations CustomerReceiptAllocation[] @relation("CustomerReceiptAllocationCreatedBy")
  cancelledCustomerReceipts         CustomerReceipt[]           @relation("CustomerReceiptCancelledBy")
  createdCustomerReceipts           CustomerReceipt[]           @relation("CustomerReceiptCreatedBy")
  branch                            Branch?                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  position                          Position?                   @relation(fields: [positionId], references: [id])
  user                              User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  inputTaxFilingBatches             InputTaxFilingBatch[]
  taxDocumentLifecycleEvents        TaxDocumentLifecycleEvent[]
  createdProductReservations        ProductReservation[]         @relation("ProductReservationCreatedBy")
  productReservationLifecycleCommands ProductReservationLifecycleCommand[] @relation("ProductReservationLifecycleCommandActor")
  productReservationLifecycleEvents ProductReservationLifecycleEvent[] @relation("ProductReservationLifecycleEventActor")
  confirmedOrders                   OrderOnline[]               @relation("EmployeeConfirmedOrders")
  payment                           Payment[]
  purchaseOrderCreated              PurchaseOrder[]
  PurchaseOrderReceipt              PurchaseOrderReceipt[]
  refundTransaction                 RefundTransaction[]
  repairJobs                        RepairJob[]
  sale                              Sale[]
  saleReturns                       SaleReturn[]
  performedStockMovements           StockMovement[]
  createdWarrantyClaims             WarrantyClaim[]             @relation("WarrantyClaimCreatedBy")
  resolvedWarrantyClaims            WarrantyClaim[]             @relation("WarrantyClaimResolvedBy")
  performedWarrantyClaimEvents      WarrantyClaimEvent[]
  deviceOwnershipHistory            DeviceOwnershipHistory[]    @relation("DeviceOwnershipCreatedBy")
  devicePassportEvents              DevicePassportEvent[]       @relation("DevicePassportActor")
  checkedDeviceIntakeItems          DeviceIntakeChecklist[]     @relation("DeviceIntakeChecklistCheckedBy")
  uploadedDeviceIntakeDocuments     DeviceIntakeDocument[]      @relation("DeviceIntakeDocumentUploadedBy")
  uploadedDeviceIntakePhotos        DeviceIntakePhoto[]         @relation("DeviceIntakePhotoUploadedBy")
  performedDeviceIntakeAudits       DeviceIntakeAudit[]         @relation("DeviceIntakeAuditPerformedBy")
  receivedDeviceIntakes             DeviceIntake[]              @relation("DeviceIntakeReceivedBy")
  diagnosedRepairJobs               RepairDiagnosis[]           @relation("RepairDiagnosisDiagnosedBy")
  performedRepairLaborItems         RepairLaborItem[]           @relation("RepairLaborPerformedBy")
  checkedRepairQualityChecks        RepairQualityCheck[]        @relation("RepairQualityCheckedBy")
  deliveredRepairJobs               RepairDelivery[]            @relation("RepairDeliveryDeliveredBy")
  createdRepairTrackingAccesses     RepairTrackingAccess[]      @relation("RepairTrackingAccessCreatedBy")
  requestedRepairEstimateApprovals  RepairEstimateApproval[]    @relation("RepairEstimateApprovalRequestedBy")
  refundedReturns                   SaleReturn[]                @relation("RefundedBy")
  salesTaxFilingBatches             SalesTaxFilingBatch[]
  assignedServices                  ServiceOrder[]
  stockAuditScanLog                 StockAuditScanLog[]
  stockAuditSession                 StockAuditSession[]
  stockItem                         StockItem[]
  supplierPayment                   SupplierPayment[]             @relation("SupplierPaymentCreatedBy")
  createdSupplierPayables           SupplierPayable[]            @relation("SupplierPayableCreatedBy")
  voidedSupplierPayments            SupplierPayment[]             @relation("SupplierPaymentVoidedBy")
  reversedSupplierPaymentAllocations SupplierPaymentAllocation[] @relation("SupplierPaymentAllocationReversedBy")
  createdSupplierAdvances            SupplierAdvance[]            @relation("SupplierAdvanceCreatedBy")
  activatedSupplierAdvances          SupplierAdvance[]            @relation("SupplierAdvanceActivatedBy")
  voidedSupplierAdvances             SupplierAdvance[]            @relation("SupplierAdvanceVoidedBy")
  reversedSupplierAdvanceAllocations SupplierAdvanceAllocation[]  @relation("SupplierAdvanceAllocationReversedBy")
  openedSupplierPayableDisputes      SupplierPayableDispute[]      @relation("SupplierPayableDisputeOpenedBy")
  resolvedSupplierPayableDisputes    SupplierPayableDispute[]      @relation("SupplierPayableDisputeResolvedBy")
  createdSupplierPayableAdjustments  SupplierPayableAdjustment[]   @relation("SupplierPayableAdjustmentCreatedBy")
  voidedSupplierPayableAdjustments   SupplierPayableAdjustment[]   @relation("SupplierPayableAdjustmentVoidedBy")
  createdPosHeldCarts                PosHeldCart[]                  @relation("PosHeldCartCreatedBy")
  updatedPosHeldCarts                PosHeldCart[]                  @relation("PosHeldCartUpdatedBy")
  cancelledPosHeldCarts              PosHeldCart[]                  @relation("PosHeldCartCancelledBy")
  v2StockAudits                     V2StockAudit[]
  createdMissingCostResolutions     MissingCostResolution[]        @relation("MissingCostResolutionCreatedBy")
  proposedMissingCostVersions       MissingCostResolutionVersion[] @relation("MissingCostResolutionVersionProposedBy")
  approvedMissingCostVersions       MissingCostResolutionVersion[] @relation("MissingCostResolutionVersionApprovedBy")
  missingCostResolutionEvents       MissingCostResolutionEvent[]   @relation("MissingCostResolutionEventActor")
}

model Branch {
  id                              Int                              @id @default(autoincrement())
  name                            String
  address                         String
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  RBACEnabled                     Boolean                          @default(true)
  phone                           String?
  subdistrictCode                 String?
  businessType                    BusinessType                     @default(GENERAL)
  features                        Json?
  branchCode                      String?                          @db.VarChar(5)
  isHeadOffice                    Boolean                          @default(false)
  taxId                           String?                          @db.VarChar(13)
  slug                            String?                          @unique
  categoryId                      Int                              @default(1)
  banks                           Bank[]
  barcodeCounter                  BarcodeCounter[]
  barcodeReceiptItem              BarcodeReceiptItem[]
  category                        Category                         @relation(fields: [categoryId], references: [id])
  subdistrict                     Subdistrict?                     @relation(fields: [subdistrictCode], references: [code])
  branchPrices                    BranchPrice[]
  combinedBillingDocument         CombinedBillingDocument[]
  combinedSaleDocument            CombinedSaleDocument[]
  customerDeposit                 CustomerDeposit[]
  customerReceipts                CustomerReceipt[]
  employees                       EmployeeProfile[]
  inputTaxFilingBatches           InputTaxFilingBatch[]
  orderOnline                     OrderOnline[]
  payment                         Payment[]
  paymentCodeCounter              PaymentCodeCounter[]
  productTypes                    ProductType[]
  positions                       Position[]
  pos                             PurchaseOrder[]
  purchaseOrderReceipt            PurchaseOrderReceipt[]
  refundTransaction               RefundTransaction[]
  repairJobs                      RepairJob[]
  sale                            Sale[]
  salesCompletionCommands         SalesCompletionCommand[]
  saleReturn                      SaleReturn[]
  saleReturnCompletionCommands    SaleReturnCompletionCommand[]
  warrantyClaims                  WarrantyClaim[]
  warrantyClaimCompletionCommands WarrantyClaimCompletionCommand[]
  devices                         Device[]
  devicePassportEvents            DevicePassportEvent[]
  deviceIntakes                   DeviceIntake[]
  salesTaxFilingBatches           SalesTaxFilingBatch[]
  services                        ServiceOrder[]
  simpleLots                      SimpleLot[]
  stockAuditSession               StockAuditSession[]
  stockBalances                   StockBalance[]
  stock                           StockItem[]
  stockMovement                   StockMovement[]
  productReservations             ProductReservation[]
  productReservationLifecycleCommands ProductReservationLifecycleCommand[]
  productReservationLifecycleEvents ProductReservationLifecycleEvent[]
  suppliers                       Supplier[]
  supplierPayment                 SupplierPayment[]
  supplierPayables                SupplierPayable[]
  supplierPayableDisputes         SupplierPayableDispute[]
  supplierPayableAdjustments      SupplierPayableAdjustment[]
  posHeldCarts                    PosHeldCart[]
  supplierAdvances                SupplierAdvance[]
  taxCandidates                   TaxCandidate[]
  taxDocuments                    TaxDocument[]
  v2StockAudits                   V2StockAudit[]
  provisionedPartnerStoreApplications PartnerStoreApplication[] @relation("PartnerStoreApplicationProvisionedBranch")
  missingCostResolutions          MissingCostResolution[]

  @@index([subdistrictCode])
}

model Product {
  id                       Int                        @id @default(autoincrement())
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  noSN                     Boolean                    @default(false)
  active                   Boolean                    @default(true)
  name                     String
  mode                     ProductMode                @default(STRUCTURED)
  inventoryBehavior        ProductInventoryBehavior   @default(TRACKED)
  saleBarcode              String?
  trackSerialNumber        Boolean                    @default(false)
  productTypeId            Int?
  brandId                  Int?
  codeType                 String?
  productConfig            Json?
  unitId                   Int?
  warrantyDays             Int?
  templateProductId        Int?
  branchPrice              BranchPrice[]
  cartItems                CartItem[]
  orderOnlineItem          OrderOnlineItem[]
  brand                    Brand?                     @relation(fields: [brandId], references: [id])
  productType              ProductType?               @relation(fields: [productTypeId], references: [id])
  templateProduct          Product?                   @relation("ProductTemplateClone", fields: [templateProductId], references: [id], onUpdate: NoAction)
  clonedProducts           Product[]                  @relation("ProductTemplateClone")
  unit                     Unit?                      @relation(fields: [unitId], references: [id])
  productImages            ProductImage[]
  orderItems               ProductOnOrder[]
  purchaseOrderItems       PurchaseOrderItem[]
  PurchaseOrderReceiptItem PurchaseOrderReceiptItem[]
  repairPartItems          RepairPartItem[]
  saleItemSimple           SaleItemSimple[]
  serviceItems             ServiceItem[]
  simpleLots               SimpleLot[]
  stockAuditSnapshotItem   StockAuditSnapshotItem[]
  posHeldCartLines         PosHeldCartLine[]
  stockBalances            StockBalance[]
  stockItems               StockItem[]
  stockMovement            StockMovement[]
  productReservationItems  ProductReservationItem[]
  v2StockAuditItems        V2StockAuditItem[]
  missingCostResolutions   MissingCostResolution[]

  @@index([mode, active])
  @@index([mode, inventoryBehavior, active])
  @@index([saleBarcode])
  @@index([productTypeId])
  @@index([brandId])
  @@index([templateProductId])
}

model StockBalance {
  id               Int      @id @default(autoincrement())
  productId        Int
  branchId         Int
  quantity         Decimal  @default(0) @db.Decimal(12, 2)
  reserved         Decimal  @default(0) @db.Decimal(12, 2)
  avgCost          Decimal? @db.Decimal(12, 2)
  lastReceivedCost Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  branch           Branch   @relation(fields: [branchId], references: [id])
  product          Product  @relation(fields: [productId], references: [id])
  missingCostResolutions MissingCostResolution[]

  @@unique([productId, branchId])
  @@index([branchId])
}

model MissingCostResolution {
  id                     Int                         @id @default(autoincrement())
  branchId               Int
  stockBalanceId         Int
  productId              Int
  sourceAuditId          String
  sourceSnapshotHash     String
  candidateIdentityHash  String
  status                 MissingCostResolutionStatus @default(DRAFT)
  currentVersion         Int                          @default(1)
  recoveryState          String?
  createdByEmployeeId    Int
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  branch                 Branch                       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stockBalance           StockBalance                 @relation(fields: [stockBalanceId], references: [id], onDelete: Restrict)
  product                Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy              EmployeeProfile              @relation("MissingCostResolutionCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  versions               MissingCostResolutionVersion[]
  events                 MissingCostResolutionEvent[]

  @@unique([branchId, candidateIdentityHash])
  @@index([branchId, status])
  @@index([branchId, stockBalanceId])
  @@index([branchId, productId])
}

model MissingCostResolutionVersion {
  id                    Int                            @id @default(autoincrement())
  resolutionId          Int
  version               Int
  sourceType            MissingCostEvidenceSourceType
  sourceReference       String
  evidenceSummary       String
  proposedUnitCost      Decimal                        @db.Decimal(12, 2)
  effectiveDate         DateTime
  confidence            MissingCostEvidenceConfidence
  rationale             String
  proposedByEmployeeId  Int
  evidenceHash          String                         @unique
  approvedByEmployeeId  Int?
  approvedAt            DateTime?
  approvedEvidenceHash  String?
  createdAt             DateTime                       @default(now())
  resolution            MissingCostResolution          @relation(fields: [resolutionId], references: [id], onDelete: Restrict)
  proposedBy            EmployeeProfile                @relation("MissingCostResolutionVersionProposedBy", fields: [proposedByEmployeeId], references: [id], onDelete: Restrict)
  approvedBy            EmployeeProfile?               @relation("MissingCostResolutionVersionApprovedBy", fields: [approvedByEmployeeId], references: [id], onDelete: Restrict)
  events                MissingCostResolutionEvent[]

  @@unique([resolutionId, version])
  @@index([resolutionId])
  @@index([approvedByEmployeeId])
}

model MissingCostResolutionEvent {
  id              Int                            @id @default(autoincrement())
  resolutionId    Int
  versionId       Int?
  eventType       MissingCostResolutionEventType
  previousStatus  MissingCostResolutionStatus?
  resultingStatus MissingCostResolutionStatus
  actorEmployeeId Int
  reasonCode      String
  note            String?
  evidenceHash    String?
  occurredAt      DateTime                        @default(now())
  createdAt       DateTime                        @default(now())
  resolution      MissingCostResolution           @relation(fields: [resolutionId], references: [id], onDelete: Restrict)
  versionRecord   MissingCostResolutionVersion?   @relation(fields: [versionId], references: [id], onDelete: Restrict)
  actor           EmployeeProfile                 @relation("MissingCostResolutionEventActor", fields: [actorEmployeeId], references: [id], onDelete: Restrict)

  @@index([resolutionId, occurredAt])
  @@index([actorEmployeeId, occurredAt])
  @@index([versionId])
}

enum MissingCostResolutionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED_FOR_CORRECTION
  CANCELLED
  SUPERSEDED
}

enum MissingCostEvidenceSourceType {
  LEGACY_INVOICE
  SUPPLIER_DOCUMENT
  PURCHASE_RECORD
  HISTORICAL_COST_REFERENCE
  MANUAL_BUSINESS_DECISION
}

enum MissingCostEvidenceConfidence {
  HIGH
  MEDIUM
  LOW
}

enum MissingCostResolutionEventType {
  CREATED
  UPDATED
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED_FOR_CORRECTION
  CANCELLED
  SUPERSEDED
}
