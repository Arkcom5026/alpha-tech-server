  customerReceiptAllocations CustomerReceiptAllocation[]
  depositUsages              DepositUsage[]
  payments                   Payment[]
  branch                     Branch                      @relation(fields: [branchId], references: [id])
  combinedBilling            CombinedBillingDocument?    @relation("CombinedBillingSales", fields: [combinedBillingId], references: [id])
  combinedDocument           CombinedSaleDocument?       @relation("SalesCombined", fields: [combinedDocumentId], references: [id])
  customer                   CustomerProfile?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  employee                   EmployeeProfile             @relation(fields: [employeeId], references: [id])
  items                      SaleItem[]
