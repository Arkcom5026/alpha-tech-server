  proposerEmployee      EmployeeProfile                 @relation("MissingCostResolutionVersionProposer", fields: [proposerEmployeeId], references: [id], onDelete: Restrict)
  approvedByEmployee    EmployeeProfile?                @relation("MissingCostResolutionVersionApprover", fields: [approvedByEmployeeId], references: [id], onDelete: Restrict)
  events                MissingCostResolutionEvent[]

  @@unique([resolutionId, version])
  @@unique([resolutionId, evidenceHash])
  @@index([resolutionId, createdAt])
  @@index([proposerEmployeeId])
  @@index([approvedByEmployeeId])
  @@index([evidenceHash])
}

model MissingCostResolutionEvent {
  id                    Int                            @id @default(autoincrement())
