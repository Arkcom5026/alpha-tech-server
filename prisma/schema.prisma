generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String?              @unique
  password            String
  role                Role
  enabled             Boolean              @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  loginId             String?              @unique
  loginType           LoginType            @default(PHONE)
  cart                Cart[]
  customerProfile     CustomerProfile?
  employeeProfile     EmployeeProfile?
  orderOnline         OrderOnline[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  provisionedPartnerStoreApplications PartnerStoreApplication[] @relation("PartnerStoreApplicationProvisionedOwner")
}

model EmployeeProfile {
  id                                Int                         @id @default(autoincrement())
  name                              String?
  phone                             String?
  userId                            Int                         @unique
  branchId                          Int?
  positionId                        Int?
  createdAt                         DateTime                    @default(now())
  updatedAt                         DateTime                    @updatedAt
  approved                          Boolean                     @default(false)
  active                            Boolean                     @default(true)
  passwordHashV2                    String?
  v2Role                            EmployeeRole                @default(CASHIER)
  combinedBillingDocument           CombinedBillingDocument[]
  combinedSaleDocument              CombinedSaleDocument[]
  customerDeposit                   CustomerDeposit[]
  createdCustomerReceiptAllocations CustomerReceiptAllocation[] @relation("CustomerReceiptAllocationCreatedBy")
  cancelledCustomerReceipts         CustomerReceipt[]           @relation("CustomerReceiptCancelledBy")
  createdCustomerReceipts           CustomerReceipt[]           @relation("CustomerReceiptCreatedBy")
  branch                            Branch?                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  position                          Position?                   @relation(fields: [positionId], references: [id])
  user                              User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  inputTaxFilingBatches             InputTaxFilingBatch[]
  taxDocumentLifecycleEvents        TaxDocumentLifecycleEvent[]
  createdProductReservations        ProductReservation[]         @relation("ProductReservationCreatedBy")
  productReservationLifecycleCommands ProductReservationLifecycleCommand[] @relation("ProductReservationLifecycleCommandActor")
  productReservationLifecycleEvents ProductReservationLifecycleEvent[] @relation("ProductReservationLifecycleEventActor")
  confirmedOrders                   OrderOnline[]               @relation("EmployeeConfirmedOrders")
  payment                           Payment[]
  purchaseOrderCreated              PurchaseOrder[]
  PurchaseOrderReceipt              PurchaseOrderReceipt[]
  refundTransaction                 RefundTransaction[]
  repairJobs                        RepairJob[]
  sale                              Sale[]
  saleReturns                       SaleReturn[]
  performedStockMovements           StockMovement[]
  createdWarrantyClaims             WarrantyClaim[]             @relation("WarrantyClaimCreatedBy")
  resolvedWarrantyClaims            WarrantyClaim[]             @relation("WarrantyClaimResolvedBy")
  performedWarrantyClaimEvents      WarrantyClaimEvent[]
  deviceOwnershipHistory            DeviceOwnershipHistory[]    @relation("DeviceOwnershipCreatedBy")
  devicePassportEvents              DevicePassportEvent[]       @relation("DevicePassportActor")
  checkedDeviceIntakeItems          DeviceIntakeChecklist[]     @relation("DeviceIntakeChecklistCheckedBy")
  uploadedDeviceIntakeDocuments     DeviceIntakeDocument[]      @relation("DeviceIntakeDocumentUploadedBy")
  uploadedDeviceIntakePhotos        DeviceIntakePhoto[]         @relation("DeviceIntakePhotoUploadedBy")
  performedDeviceIntakeAudits       DeviceIntakeAudit[]         @relation("DeviceIntakeAuditPerformedBy")
  receivedDeviceIntakes             DeviceIntake[]              @relation("DeviceIntakeReceivedBy")
  diagnosedRepairJobs               RepairDiagnosis[]           @relation("RepairDiagnosisDiagnosedBy")
  performedRepairLaborItems         RepairLaborItem[]           @relation("RepairLaborPerformedBy")
  checkedRepairQualityChecks        RepairQualityCheck[]        @relation("RepairQualityCheckedBy")
  deliveredRepairJobs               RepairDelivery[]            @relation("RepairDeliveryDeliveredBy")
  createdRepairTrackingAccesses     RepairTrackingAccess[]      @relation("RepairTrackingAccessCreatedBy")
  requestedRepairEstimateApprovals  RepairEstimateApproval[]    @relation("RepairEstimateApprovalRequestedBy")
  refundedReturns                   SaleReturn[]                @relation("RefundedBy")
  salesTaxFilingBatches             SalesTaxFilingBatch[]
  assignedServices                  ServiceOrder[]
  stockAuditScanLog                 StockAuditScanLog[]
  stockAuditSession                 StockAuditSession[]
  stockItem                         StockItem[]
  supplierPayment                   SupplierPayment[]             @relation("SupplierPaymentCreatedBy")
  createdSupplierPayables           SupplierPayable[]            @relation("SupplierPayableCreatedBy")
  voidedSupplierPayments            SupplierPayment[]             @relation("SupplierPaymentVoidedBy")
  reversedSupplierPaymentAllocations SupplierPaymentAllocation[] @relation("SupplierPaymentAllocationReversedBy")
  createdSupplierAdvances            SupplierAdvance[]            @relation("SupplierAdvanceCreatedBy")
  activatedSupplierAdvances          SupplierAdvance[]            @relation("SupplierAdvanceActivatedBy")
  voidedSupplierAdvances             SupplierAdvance[]            @relation("SupplierAdvanceVoidedBy")
  reversedSupplierAdvanceAllocations SupplierAdvanceAllocation[]  @relation("SupplierAdvanceAllocationReversedBy")
  openedSupplierPayableDisputes      SupplierPayableDispute[]      @relation("SupplierPayableDisputeOpenedBy")
  resolvedSupplierPayableDisputes    SupplierPayableDispute[]      @relation("SupplierPayableDisputeResolvedBy")
  createdSupplierPayableAdjustments  SupplierPayableAdjustment[]   @relation("SupplierPayableAdjustmentCreatedBy")
  voidedSupplierPayableAdjustments   SupplierPayableAdjustment[]   @relation("SupplierPayableAdjustmentVoidedBy")
  createdPosHeldCarts                PosHeldCart[]                  @relation("PosHeldCartCreatedBy")
  updatedPosHeldCarts                PosHeldCart[]                  @relation("PosHeldCartUpdatedBy")
  cancelledPosHeldCarts              PosHeldCart[]                  @relation("PosHeldCartCancelledBy")
  v2StockAudits                     V2StockAudit[]
  createdMissingCostResolutions      MissingCostResolution[]        @relation("MissingCostResolutionCreatedBy")
  approvedMissingCostResolutions     MissingCostResolution[]        @relation("MissingCostResolutionApprovedBy")
  proposedMissingCostResolutionVersions MissingCostResolutionVersion[] @relation("MissingCostResolutionVersionProposer")
  approvedMissingCostResolutionVersions MissingCostResolutionVersion[] @relation("MissingCostResolutionVersionApprover")
  performedMissingCostResolutionEvents MissingCostResolutionEvent[] @relation("MissingCostResolutionEventActor")
  createdTaxExpenses                    TaxExpense[]                @relation("TaxExpenseCreatedBy")
  assessedTaxExpenses                   TaxExpenseAssessment[]      @relation("TaxExpenseAssessmentAssessedBy")
  performedTaxExpenseEvents             TaxExpenseLifecycleEvent[]  @relation("TaxExpenseLifecycleEventActor")
  uploadedTaxExpenseAttachments         TaxExpenseAttachment[]      @relation("TaxExpenseAttachmentUploadedBy")
  productTemplateCandidatesCreated      ProductTemplateCandidate[]  @relation("ProductTemplateCandidateCreatedBy")
  productTemplateCandidatesReviewed     ProductTemplateCandidate[]  @relation("ProductTemplateCandidateReviewedBy")
  productTemplateCandidateEvents        ProductTemplateCandidateEvent[] @relation("ProductTemplateCandidateEventActor")
}

model Branch {
  id                              Int                              @id @default(autoincrement())
  name                            String
  address                         String
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  RBACEnabled                     Boolean                          @default(true)
  phone                           String?
  subdistrictCode                 String?
  businessType                    BusinessType                     @default(GENERAL)
  features                        Json?
  branchCode                      String?                          @db.VarChar(5)
  isHeadOffice                    Boolean                          @default(false)
  taxId                           String?                          @db.VarChar(13)
  slug                            String?                          @unique
  categoryId                      Int                              @default(1)

  banks                           Bank[]
  barcodeCounter                  BarcodeCounter[]
  barcodeReceiptItem              BarcodeReceiptItem[]
  category                        Category                         @relation(fields: [categoryId], references: [id])
  subdistrict                     Subdistrict?                     @relation(fields: [subdistrictCode], references: [code])
  branchPrices                    BranchPrice[]
  combinedBillingDocument         CombinedBillingDocument[]
  combinedSaleDocument            CombinedSaleDocument[]
  customerProfiles                CustomerProfile[]
  customerDeposit                 CustomerDeposit[]
  customerReceipts                CustomerReceipt[]
  employees                       EmployeeProfile[]
  inputTaxFilingBatches           InputTaxFilingBatch[]
  orderOnline                     OrderOnline[]
  payment                         Payment[]
  paymentCodeCounter              PaymentCodeCounter[]
  productTypes                    ProductType[]
  products                        Product[]
  brands                          Brand[]
  positions                       Position[]
  pos                             PurchaseOrder[]
  purchaseOrderReceipt            PurchaseOrderReceipt[]
  refundTransaction               RefundTransaction[]
  repairJobs                      RepairJob[]
  sale                            Sale[]
  salesCompletionCommands         SalesCompletionCommand[]
  saleReturn                      SaleReturn[]
  saleReturnCompletionCommands    SaleReturnCompletionCommand[]
  warrantyClaims                  WarrantyClaim[]
  warrantyClaimCompletionCommands WarrantyClaimCompletionCommand[]
  devices                         Device[]
  devicePassportEvents            DevicePassportEvent[]
  deviceIntakes                   DeviceIntake[]
  salesTaxFilingBatches           SalesTaxFilingBatch[]
  services                        ServiceOrder[]
  simpleLots                      SimpleLot[]
  stockAuditSession               StockAuditSession[]
  stockBalances                   StockBalance[]
  stock                           StockItem[]
  stockMovement                   StockMovement[]
  productReservations             ProductReservation[]
  productReservationLifecycleCommands ProductReservationLifecycleCommand[]
  productReservationLifecycleEvents ProductReservationLifecycleEvent[]
  suppliers                       Supplier[]
  supplierPayment                 SupplierPayment[]
  supplierPayables                SupplierPayable[]
  supplierPayableDisputes         SupplierPayableDispute[]
  supplierPayableAdjustments      SupplierPayableAdjustment[]
  posHeldCarts                    PosHeldCart[]
  supplierAdvances                SupplierAdvance[]
  taxCandidates                   TaxCandidate[]
  taxDocuments                    TaxDocument[]
  v2StockAudits                   V2StockAudit[]
  provisionedPartnerStoreApplications PartnerStoreApplication[] @relation("PartnerStoreApplicationProvisionedBranch")
  missingCostResolutions               MissingCostResolution[]
  taxExpenseCategories                 TaxExpenseCategory[]
  taxExpenses                          TaxExpense[]
  taxIssuerProfile                     TaxIssuerProfile?
  sourceProductTemplateCandidates      ProductTemplateCandidate[] @relation("ProductTemplateCandidateSourceBranch")
  targetProductTemplateCandidates      ProductTemplateCandidate[] @relation("ProductTemplateCandidateTargetBranch")

  @@index([subdistrictCode])
}

enum TaxIssuerProfileStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

model TaxIssuerProfile {
  id                         Int                    @id @default(autoincrement())
  branchId                   Int                    @unique
  legalName                  String?
  taxId                      String?                @db.VarChar(13)
  registeredAddress          String?
  branchCode                 String                 @default("00000") @db.VarChar(5)
  isHeadOffice               Boolean                @default(false)
  shortTaxInvoicePrefix      String?
  fullTaxInvoicePrefix       String?
  nextShortTaxInvoiceNumber  Int                    @default(1)
  nextFullTaxInvoiceNumber   Int                    @default(1)
  creditNotePrefix           String?
  nextCreditNoteNumber       Int                    @default(1)
  status                     TaxIssuerProfileStatus @default(DRAFT)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  branch                     Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  issuedTaxDocuments         TaxDocument[]          @relation("TaxDocumentIssuerProfile")

  @@index([status])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)
  isSystem  Boolean  @default(false)

  branches           Branch[]
  globalProductTypes GlobalProductType[]
}

model GlobalProductType {
  id           Int           @id @default(autoincrement())
  name         String
  slug         String        @unique
  active       Boolean       @default(true)
  categoryId   Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  category     Category      @relation(fields: [categoryId], references: [id])
  productTypes ProductType[]

  @@index([categoryId])
  @@index([active])
}

model ProductTypeBrand {
  id            Int         @id @default(autoincrement())
  productTypeId Int
  brandId       Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  brand         Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@unique([productTypeId, brandId])
  @@index([productTypeId])
  @@index([brandId])
}

model ProductType {
  id                  Int      @id @default(autoincrement())
  name                String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  active              Boolean  @default(true)
  guideExamples       String[] @default([])
  normalizedName      String?
  pathCached          String?
  branchId            Int?
  globalProductTypeId Int

  Product           Product[]
  branch            Branch?            @relation(fields: [branchId], references: [id])
  globalProductType GlobalProductType  @relation(fields: [globalProductTypeId], references: [id])
  productTypeBrands ProductTypeBrand[]

  @@unique([branchId, globalProductTypeId, normalizedName])
  @@index([branchId])
  @@index([globalProductTypeId])
}

model Brand {
  id                Int                @id @default(autoincrement())
  name              String
  normalizedName    String             @unique
  branchId          Int?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  products          Product[]
  productTypeBrands ProductTypeBrand[]
  branch            Branch?            @relation(fields: [branchId], references: [id])

  @@index([active])
  @@index([name])
  @@index([branchId])
  @@index([branchId, active])
  @@index([branchId, normalizedName])
}

model Product {
  id                       Int                        @id @default(autoincrement())
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  noSN                     Boolean                    @default(false)
  active                   Boolean                    @default(true)
  name                     String
  mode                     ProductMode                @default(STRUCTURED)
  inventoryBehavior        ProductInventoryBehavior   @default(TRACKED)
  saleBarcode              String?
  trackSerialNumber        Boolean                    @default(false)
  productTypeId            Int?
  brandId                  Int?
  codeType                 String?
  productConfig            Json?
  unitId                   Int?
  warrantyDays             Int?
  templateProductId        Int?
  branchId                 Int?
  branchPrice              BranchPrice[]
  cartItems                CartItem[]
  orderOnlineItem          OrderOnlineItem[]
  brand                    Brand?                     @relation(fields: [brandId], references: [id])
  productType              ProductType?               @relation(fields: [productTypeId], references: [id])
  branch                   Branch?                    @relation(fields: [branchId], references: [id])
  templateProduct          Product?                   @relation("ProductTemplateClone", fields: [templateProductId], references: [id], onUpdate: NoAction)
  clonedProducts           Product[]                  @relation("ProductTemplateClone")
  unit                     Unit?                      @relation(fields: [unitId], references: [id])
  productImages            ProductImage[]
  orderItems               ProductOnOrder[]
  purchaseOrderItems       PurchaseOrderItem[]
  PurchaseOrderReceiptItem PurchaseOrderReceiptItem[]
  repairPartItems          RepairPartItem[]
  saleItemSimple           SaleItemSimple[]
  serviceItems             ServiceItem[]
  simpleLots               SimpleLot[]
  stockAuditSnapshotItem   StockAuditSnapshotItem[]
  posHeldCartLines         PosHeldCartLine[]
  stockBalances            StockBalance[]
  stockItems               StockItem[]
  stockMovement            StockMovement[]
  productReservationItems  ProductReservationItem[]
  v2StockAuditItems        V2StockAuditItem[]
  missingCostResolutions   MissingCostResolution[]
  sourceProductTemplateCandidates ProductTemplateCandidate[] @relation("ProductTemplateCandidateSourceProduct")
  targetProductTemplateCandidates ProductTemplateCandidate[] @relation("ProductTemplateCandidateTargetProduct")

  @@index([mode, active])
  @@index([mode, inventoryBehavior, active])
  @@index([saleBarcode])
  @@index([productTypeId])
  @@index([brandId])
  @@index([templateProductId])
  @@index([branchId])
  @@index([branchId, active])
  @@index([branchId, productTypeId])
  @@index([branchId, templateProductId])
}

model BranchPrice {
  id              Int       @id @default(autoincrement())
  productId       Int
  branchId        Int
  effectiveDate   DateTime?
  expiredDate     DateTime?
  note            String?
  updatedBy       Int?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  costPrice       Decimal   @db.Decimal(12, 2)
  priceOnline     Int?
  priceRetail     Int?
  priceTechnician Int?
  priceWholesale  Int?
  branch          Branch    @relation(fields: [branchId], references: [id])
  product         Product   @relation(fields: [productId], references: [id])

  @@unique([productId, branchId])
}

model StockBalance {
  id               Int      @id @default(autoincrement())
  productId        Int
  branchId         Int
  quantity         Decimal  @default(0) @db.Decimal(12, 2)
  reserved         Decimal  @default(0) @db.Decimal(12, 2)
  avgCost          Decimal? @db.Decimal(12, 2)
  lastReceivedCost Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  branch           Branch   @relation(fields: [branchId], references: [id])
  product          Product  @relation(fields: [productId], references: [id])
  missingCostResolutions MissingCostResolution[]

  @@unique([productId, branchId])
  @@index([branchId])
}

model StockMovement {
  id                    Int               @id @default(autoincrement())
  productId             Int
  branchId              Int
  qty                   Decimal           @db.Decimal(12, 2)
  type                  StockMovementType
  refType               String?
  refId                 Int?
  note                  String?
  createdAt             DateTime          @default(now())
  simpleLotId           Int?
  stockItemId           Int?
  previousStockStatus   StockStatus?
  resultingStockStatus  StockStatus?
  performedByEmployeeId Int?
  occurredAt            DateTime          @default(now())
  branch                Branch            @relation(fields: [branchId], references: [id])
  product               Product           @relation(fields: [productId], references: [id])
  simpleLots            SimpleLot?        @relation(fields: [simpleLotId], references: [id])
  stockItem             StockItem?        @relation(fields: [stockItemId], references: [id])
  performedBy           EmployeeProfile?  @relation(fields: [performedByEmployeeId], references: [id])

  @@index([branchId, createdAt])
  @@index([productId, createdAt])
  @@index([branchId, type, createdAt])
  @@index([productId, branchId, createdAt])
  @@index([stockItemId, occurredAt])
  @@index([simpleLotId, occurredAt])
  @@index([branchId, type, occurredAt])
  @@index([productId, branchId, occurredAt])
}

model ProductImage {
  id         Int      @id @default(autoincrement())
  public_id  String   @unique
  url        String
  secure_url String
  active     Boolean  @default(true)
  productId  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  caption    String?
  isCover    Boolean?
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Unit {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Product   Product[]
}

model StockItem {
  id                         Int                       @id @default(autoincrement())
  barcode                    String                    @unique
  serialNumber               String?
  receivedAt                 DateTime                  @default(now())
  warrantyDays               Int?
  expiredAt                  DateTime?
  soldAt                     DateTime?
  remark                     String?
  productId                  Int
  branchId                   Int
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  status                     StockStatus               @default(IN_STOCK)
  purchaseOrderReceiptItemId Int?
  batchNumber                String?
  checkedBy                  String?
  locationCode               String?
  qrCodeData                 String?
  source                     String?
  tag                        String?
  scannedAt                  DateTime                  @default(now())
  scannedByEmployeeId        Int?
  color                      String?
  costPrice                  Decimal?                  @db.Decimal(12, 2)
  barcodeReceiptItem         BarcodeReceiptItem[]
  repairJobs                 RepairJob[]
  saleItems                  SaleItem[]
  stockMovements             StockMovement[]
  productReservationItems    ProductReservationItem[]
  stockAuditScanLog          StockAuditScanLog[]
  stockAuditSnapshotItem     StockAuditSnapshotItem[]
  branch                     Branch                    @relation(fields: [branchId], references: [id])
  product                    Product                   @relation(fields: [productId], references: [id])
  purchaseOrderReceiptItem   PurchaseOrderReceiptItem? @relation(fields: [purchaseOrderReceiptItemId], references: [id])
  scannedBy                  EmployeeProfile?          @relation(fields: [scannedByEmployeeId], references: [id])
  warrantyClaims             WarrantyClaim[]
  replacementWarrantyClaims  WarrantyClaim[]           @relation("WarrantyClaimReplacementStockItem")
  devices                    Device[]
  posHeldCartLines           PosHeldCartLine[]

  @@unique([serialNumber, productId])
  @@index([branchId, status, productId])
  @@index([productId, status])
}

model V2StockAudit {
  id        Int                @id @default(autoincrement())
  branchId  Int
  auditorId Int
  status    String             @default("PENDING")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  auditor   EmployeeProfile    @relation(fields: [auditorId], references: [id])
  branch    Branch             @relation(fields: [branchId], references: [id])
  items     V2StockAuditItem[]

  @@index([branchId])
}

model V2StockAuditItem {
  id           Int          @id @default(autoincrement())
  stockAuditId Int
  productId    Int
  expectedQty  Int
  actualQty    Int
  difference   Int
  product      Product      @relation(fields: [productId], references: [id])
  stockAudit   V2StockAudit @relation(fields: [stockAuditId], references: [id], onDelete: Cascade)
}

enum SupplierCapability {
  PROCUREMENT
  EXPENSE_PAYEE
}

model Supplier {
  id                   Int                    @id @default(autoincrement())
  name                 String
  address              String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  contactPerson        String?
  country              String?                @default("Thailand")
  creditLimit          Decimal?               @default(0) @db.Decimal(12, 2)
  email                String?
  notes                String?
  paymentTerms         Int?                   @default(0)
  phone                String?
  postalCode           String?
  province             String?
  taxId                String?
  accountNumber        String?
  accountType          String?
  bankId               Int?
  branchId             Int
  active               Boolean                @default(true)
  creditBalance        Decimal?               @default(0) @db.Decimal(12, 2)
  taxBranchCode        String?                @default("00000")
  isSystem             Boolean                @default(false)
  pos                  PurchaseOrder[]
  PurchaseOrderReceipt PurchaseOrderReceipt[]
  bank                 Bank?                  @relation(fields: [bankId], references: [id])
  branch               Branch                 @relation(fields: [branchId], references: [id])
  supplierPayment      SupplierPayment[]
  supplierPayables     SupplierPayable[]
  supplierPayableDisputes SupplierPayableDispute[]
  supplierPayableAdjustments SupplierPayableAdjustment[]
  supplierAdvances     SupplierAdvance[]
  warrantyClaims       WarrantyClaim[]
  taxExpenses          TaxExpense[] @relation("TaxExpenseSupplier")
  capabilities         SupplierCapabilityAssignment[]

  @@unique([branchId, name])
  @@unique([id, branchId])
}

model SupplierCapabilityAssignment {
  id         Int                @id @default(autoincrement())
  supplierId Int
  capability SupplierCapability
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  supplier   Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([supplierId, capability])
  @@index([capability, supplierId])
}

model Bank {
  id        Int        @id @default(autoincrement())
  name      String
  branchId  Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  active    Boolean    @default(true)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier  Supplier[]

  @@unique([branchId, name])
  @@index([branchId])
  @@index([branchId, active])
}

model PurchaseOrder {
  id         Int                    @id @default(autoincrement())
  code       String                 @unique
  date       DateTime               @default(now())
  note       String?
  status     PurchaseOrderStatus    @default(PENDING)
  supplierId Int
  branchId   Int
  employeeId Int
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  branch     Branch                 @relation(fields: [branchId], references: [id])
  employee   EmployeeProfile        @relation(fields: [employeeId], references: [id])
  supplier   Supplier               @relation(fields: [supplierId], references: [id])
  items      PurchaseOrderItem[]
  receipts   PurchaseOrderReceipt[]
}

model PurchaseOrderItem {
  id               Int                        @id @default(autoincrement())
  productId        Int
  quantity         Int
  purchaseOrderId  Int
  receivedQuantity Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  costPrice        Decimal                    @db.Decimal(12, 2)
  product          Product                    @relation(fields: [productId], references: [id])
  purchaseOrder    PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receipts         PurchaseOrderReceiptItem[]
}

model PurchaseOrderReceipt {
  id                       Int                        @id @default(autoincrement())
  receivedAt               DateTime                   @default(now())
  note                     String?
  purchaseOrderId          Int?
  branchId                 Int
  receivedById             Int
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  code                     String                     @unique
  printed                  Boolean                    @default(false)
  paidAmount               Decimal?                   @db.Decimal(12, 2)
  totalAmount              Decimal?                   @db.Decimal(12, 2)
  statusPayment            PaymentStatus              @default(UNPAID)
  statusReceipt            ReceiptStatus              @default(PENDING)
  supplierTaxInvoiceDate   DateTime?
  supplierTaxInvoiceNumber String?
  deliveryNoteNumber       String?
  deliveryNoteDate         DateTime?
  taxDocumentMode          InputTaxDocumentMode       @default(UNCLASSIFIED)
  taxDocumentReceivedAt    DateTime?
  taxDocumentReceiptSource TaxDocumentReceiptSource?
  vatRate                  Decimal?                   @default(7) @db.Decimal(5, 2)
  source                   ReceiptSource              @default(PO)
